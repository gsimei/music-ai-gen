# =============================================================================
# Music AI Gen — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Rails (Secao 17 — em uso desde o setup)
# -----------------------------------------------------------------------------
# RAILS_MASTER_KEY é gerenciado via config/master.key (não usar aqui em prod)
# O banco local já vem de config/database.yml. Se usar uma URL externa,
# defina-a no ambiente correspondente, sem apontar testes ao banco development.
# DATABASE_URL=postgres://localhost/music_ai_gen_development

# Redis não utilizado por padrão (Solid Queue usa PostgreSQL). Adicionar se
# ActionCable migrar para Redis em produção.
# REDIS_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Sentry (Secao 17 — em uso a partir da Secao 1 Setup)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Stripe (Secao 17 — em uso a partir da Secao 8 Stripe Checkout)
# -----------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Anthropic / Claude (Secao 17 — em uso a partir da Secao 9 LyricsGenerator)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Mureka API (Secao 17 — em uso a partir da Secao 11 MurekaClient)
# -----------------------------------------------------------------------------
MUREKA_API_KEY=
# Preencher somente se a Mureka suportar webhooks (verificar documentacao)
MUREKA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Storage — Cloudflare R2 (Secao 17 — em uso a partir da Secao 14 Delivery)
# -----------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Formato: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_PUBLIC=music-previews-public
R2_BUCKET_PRIVATE=music-finals-private

# -----------------------------------------------------------------------------
# Email transacional — Resend via SMTP
# No desenvolvimento, defina MAIL_DELIVERY_METHOD=resend para ativar envio real.
# Sem essa opção, permanece o SMTP local. Testes nunca enviam e-mails reais.
# Plano e configuração: https://resend.com/docs/send-with-smtp
# -----------------------------------------------------------------------------
RESEND_API_KEY=
MAILER_FROM=avisos@virajingle.com.br
# MAIL_DELIVERY_METHOD=resend
# Para produção, use as variáveis de .env.production.example.
