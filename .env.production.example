# Modelo apenas. NUNCA preencher ou versionar chaves reais neste arquivo.
# Copie para .env.production (ignorado pelo Git) e carregue no ambiente do deploy.
# Domínio adquirido. Ajuste APP_HOST se o site for publicado em um subdomínio.
APP_HOST=virajingle.com.br
MAILER_FROM=avisos@virajingle.com.br
RESEND_API_KEY=

# SSH do servidor e acesso ao GitHub Container Registry.
DEPLOY_HOST=
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=

# Quatro bancos PostgreSQL distintos, no mesmo servidor ou em serviço gerenciado.
DATABASE_URL=
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=
CABLE_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MUREKA_API_KEY=
# Opcional, mas necessário para receber alertas de falhas no Sentry.
SENTRY_DSN=

# Kamal já define true: use apenas atrás de um proxy confiável com HTTPS ativo.
BEHIND_SSL_PROXY=true
