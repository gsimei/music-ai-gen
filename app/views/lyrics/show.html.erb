<% content_for :title, @order.briefing&.about.presence || t("lyrics.title") %>

<%# Turbo Stream subscription — receives broadcast after regen job completes %>
<%= turbo_stream_from "order_#{@order.id}_lyrics" %>

<div class="bg-cant-paper text-cant-ink font-cant-body min-h-screen w-full">

  <%# ── Top bar ──────────────────────────────────────────────── %>
  <div class="px-4 pt-5 sm:px-6 flex items-center justify-between border-b border-cant-line">
    <div class="flex items-center gap-2 pb-4">
      <svg width="20" height="22" viewBox="0 0 64 70" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M52 12 C44 6, 36 4, 28 4 C14 4, 6 14, 6 32 C6 50, 14 60, 28 60 C36 60, 44 58, 52 52" stroke-linecap="square"/>
        <path d="M22 32 H 48" stroke-linecap="square"/>
        <circle cx="48" cy="32" r="2.6" fill="currentColor" stroke="none"/>
      </svg>
      <span class="font-cant-display text-xl font-medium">JinglePro</span>
    </div>
    <span class="text-[10px] tracking-wider pb-4 text-cant-mute">
      Passo 5 · 05 / 05
    </span>
  </div>

  <%# ── Page header ──────────────────────────────────────────── %>
  <div class="px-4 pt-6 pb-1 sm:px-6 sm:max-w-lg sm:mx-auto">
    <div class="text-[10px] tracking-[0.22em] uppercase text-cant-mute mb-2">
      <%= t("lyrics.title") %>
    </div>
    <h1 class="font-cant-display font-medium tracking-tight leading-none text-[32px]">
      <%= @order.briefing&.about.presence || t("lyrics.title") %>
    </h1>
    <%# Contextual meta — style, voice, duration %>
    <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-[11px] text-cant-mute">
      <% if @order.briefing&.music_style.present? %>
        <span><%= @order.briefing.music_style %></span>
      <% end %>
      <% if @order.briefing&.language.present? %>
        <span class="opacity-50">&middot;</span>
        <span><%= @order.briefing.language.upcase %></span>
      <% end %>
      <% if @order.briefing&.occasion.present? %>
        <span class="opacity-50">&middot;</span>
        <span><%= @order.briefing.occasion %></span>
      <% end %>
    </div>
  </div>

  <%# Flash messages %>
  <% if notice.present? %>
    <div role="alert"
         aria-live="polite"
         class="mx-4 mt-4 sm:mx-6 sm:max-w-lg sm:mx-auto px-4 py-3 rounded-lg text-sm
                bg-green-50 border border-green-200 text-green-800">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div role="alert"
         aria-live="assertive"
         class="mx-4 mt-4 sm:mx-6 sm:max-w-lg sm:mx-auto px-4 py-3 rounded-lg text-sm
                bg-red-50 border border-red-200 text-red-800">
      <%= alert %>
    </div>
  <% end %>

  <%# Error zone for Turbo Stream regen errors %>
  <div id="lyrics_errors" class="mx-4 sm:mx-6 sm:max-w-lg sm:mx-auto"></div>

  <%# Generating notice zone — replaced by Turbo Stream when regen is submitted %>
  <div id="lyrics_generating_notice" class="mx-4 sm:mx-6 sm:max-w-lg sm:mx-auto"></div>

  <%# Main content area — replaced wholesale by Turbo Stream when regen completes %>
  <div id="lyrics_content" class="px-4 pt-4 pb-10 sm:px-6 sm:max-w-lg sm:mx-auto">
    <%= render "lyrics/lyrics_content", order: @order, draft: @draft %>
  </div>

</div>
