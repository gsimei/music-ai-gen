<% content_for :title, "Scegli il tuo arrangiamento" %>

<div class="bg-cant-paper text-cant-ink font-cant-body min-h-screen w-full">

  <%# ── Top bar ──────────────────────────────────────────────── %>
  <div class="px-4 pt-5 sm:px-6 flex items-center justify-between border-b border-cant-line">
    <div class="flex items-center gap-2 pb-4">
      <%= render "shared/studio_logo" %>
    </div>
    <span class="text-[10px] tracking-wider pb-4 text-cant-mute">
      Quasi pronto · arrangiamento
    </span>
  </div>

  <%# Flash messages %>
  <% if notice.present? %>
    <div role="alert"
         aria-live="polite"
         class="mx-4 mt-4 sm:mx-auto sm:max-w-lg px-4 py-3 rounded-lg text-sm
                bg-green-50 border border-green-200 text-green-800">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div role="alert"
         aria-live="assertive"
         class="mx-4 mt-4 sm:mx-auto sm:max-w-lg px-4 py-3 rounded-lg text-sm
                bg-red-50 border border-red-200 text-red-800">
      <%= alert %>
    </div>
  <% end %>

  <%# ── Page header ──────────────────────────────────────────── %>
  <div class="px-4 pt-6 pb-3 sm:px-6 sm:max-w-lg sm:mx-auto">
    <div class="text-[10px] tracking-[0.22em] uppercase text-cant-mute mb-2">
      Scegli l'arrangiamento
    </div>
    <h1 class="font-cant-display font-medium tracking-tight leading-none text-[32px]">
      Abbiamo scritto <span class="italic text-cant-brass">due</span> versioni.
    </h1>
    <p class="mt-2 text-[12.5px] text-cant-mute leading-relaxed">
      30 secondi ciascuna. Scegli quella che sente di pi&ugrave; la tua bottega.
    </p>
  </div>

  <%# ── Variant cards ────────────────────────────────────────── %>
  <div class="px-4 pt-2 pb-4 sm:px-6 sm:max-w-lg sm:mx-auto space-y-4">
    <% @assets.each do |asset| %>
      <% variant_letter = asset.variant_index == 0 ? "a" : "b" %>
      <% label = asset.variant_index == 0 ? "Versione A" : "Versione B" %>
      <% duration_secs = asset.duration_ms.present? ? asset.duration_ms / 1000 : nil %>
      <% duration_str  = duration_secs ? "%d:%02d" % [duration_secs / 60, duration_secs % 60] : nil %>

      <article class="bg-cant-ink text-cant-paper rounded-sm p-4"
               aria-label="<%= label %>">
        <div class="flex justify-between items-center mb-1">
          <div class="italic tracking-tight text-[26px] leading-none"
               style="font-family: var(--font-cant-display)">
            variante <span class="not-italic text-cant-brass"><%= variant_letter.upcase %></span>
          </div>
          <% if duration_str %>
            <div class="text-[10px] tracking-wider opacity-55"><%= duration_str %></div>
          <% end %>
        </div>
        <% if @order.briefing&.music_style.present? %>
          <div class="text-[11px] opacity-60 mb-3">
            <%= @order.briefing.music_style %>
          </div>
        <% end %>

        <%# Native audio player %>
        <div class="mt-3">
          <audio controls preload="none" src="<%= asset.listening_url %>"
                 class="w-full"
                 aria-label="<%= label %> — ascolta l'anteprima">
            Il tuo browser non supporta la riproduzione audio.
          </audio>
        </div>

        <%# Approve button %>
        <%= button_to approve_order_music_path(@order),
              method: :post,
              params: { variant: variant_letter },
              form: { "aria-label": "Approva #{label}" },
              class: "mt-4 w-full min-h-[48px] bg-cant-brass text-cant-ink rounded-full py-3 px-4
                      text-[13px] font-semibold flex items-center justify-between
                      hover:brightness-95 focus-visible:outline focus-visible:outline-2
                      focus-visible:outline-offset-2 focus-visible:outline-cant-brass
                      transition-all duration-150" do %>
          <span>Scegli questa versione</span>
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        <% end %>
      </article>
    <% end %>
  </div>

  <%# ── Music regen remaining note ─────────────────────────────── %>
  <% if @order.music_regen_remaining > 0 %>
    <div class="px-4 pb-10 sm:px-6 sm:max-w-lg sm:mx-auto">
      <p class="text-center text-[12px] text-cant-mute">
        Hai ancora
        <strong class="text-cant-ink"><%= @order.music_regen_remaining %></strong>
        <%= @order.music_regen_remaining == 1 ? "generazione disponibile" : "generazioni disponibili" %> &mdash;
        contatta il supporto se hai bisogno di una nuova versione.
      </p>
    </div>
  <% end %>

</div>
