<%= form_with url: order_chat_creation_path(order_id: order.id), class: "creative-creation-form", data: { turbo_stream: true, action: "input->creative-editor#feedbackChanged change->creative-editor#feedbackChanged turbo:submit-end->creative-editor#restoreChanges" } do %>
  <%= hidden_field_tag :draft_id, draft.id %>
  <%= label_tag "editable-lyrics", "Sua letra" %>
  <%= text_area_tag :content, draft.content, id: "editable-lyrics", rows: 7, maxlength: 5000, required: true, aria: { describedby: "lyrics-help" } %>
  <p id="lyrics-help" class="studio-field-hint">Você pode escrever diretamente no texto. Editar a letra não gasta uma geração musical.</p>
  <% unless order.lyrics_regen_exhausted? %>
    <details id="rewrite-lyrics" class="creative-details">
      <summary>Pedir ajuda para reescrever a letra</summary>
      <%= label_tag :lyrics_feedback, "O que você quer mudar na letra?" %>
      <%= text_area_tag :lyrics_feedback, nil, rows: 2, maxlength: 1000, placeholder: "Ex.: deixe mais curta e inclua o nome da loja." %>
      <button type="submit" name="intent" value="rewrite" class="studio-button studio-button-outline">Reescrever a letra</button>
      <p class="studio-field-hint">Você confere o novo texto antes de gerar músicas. <%= order.lyrics_regen_remaining %> pedidos de reescrita disponíveis.</p>
    </details>
  <% end %>
  <details id="creation-sound" class="creative-details">
    <summary>Estilo musical · <%= order.campaign.sound_summary %> · Alterar</summary>
    <%= fields_for :campaign, order.campaign do |sound| %>
      <div class="creative-simple-sound">
        <div><%= sound.label :musical_genre, "Ritmo" %><%= sound.select :musical_genre, Campaign::GENRES.map { |key, value| [value[:label], key] } %></div>
        <div><%= sound.label :vocal_gender, "Voz" %><%= sound.select :vocal_gender, Campaign::VOCAL_GENDERS.map { |key, value| [value, key] } %></div>
        <div><%= sound.label :style, "Clima" %><%= sound.select :style, Campaign::STYLES.map { |key, value| [value[:label], key] } %></div>
      </div>
      <%= sound.label :music_notes, "Alguma preferência de som? (opcional)" %>
      <%= sound.text_area :music_notes, rows: 2, maxlength: 240, placeholder: "Ex.: violão em destaque e voz suave." %>
    <% end %>
  </details>
  <% if completed.positive? %>
    <%= label_tag :feedback, "O que você quer diferente na música? (opcional)" %>
    <%= text_area_tag :feedback, nil, rows: 2, maxlength: 400, placeholder: "Ex.: mais animada, com um refrão mais marcante." %>
    <p class="studio-field-hint">Vamos criar duas novas interpretações. A melodia pode mudar.</p>
  <% end %>
  <div class="creative-form-actions">
    <button type="submit" name="intent" value="generate" class="studio-button studio-button-green"><%= completed.zero? ? "Gerar duas músicas" : "Gerar duas novas músicas" %></button>
    <button type="submit" name="intent" value="save" class="studio-text-link">Salvar alterações</button>
  </div>
  <p class="studio-field-hint">Você pode gerar <%= completed.zero? ? 'até ' : 'mais ' %><%= Campaigns::MusicRounds::LIMIT - completed %> <%= Campaigns::MusicRounds::LIMIT - completed == 1 ? 'vez' : 'vezes' %>. Cada geração cria duas músicas.</p>
<% end %>
