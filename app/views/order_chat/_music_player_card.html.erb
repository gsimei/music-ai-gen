<div id="chat-music-card" class="flex justify-start">
  <div class="bg-white border border-cant-line rounded-2xl rounded-bl-sm p-5 max-w-[85%] w-full">
    <div class="flex items-center justify-between mb-4">
      <span class="text-xs font-semibold text-cant-muted uppercase tracking-wide"><%= t("order_chat.music_preview_label") %></span>
      <span class="text-xs text-cant-muted"><%= t("order_chat.music_choose_variant") %></span>
    </div>

    <div class="space-y-3">
      <% assets.each_with_index do |asset, i| %>
        <div class="rounded-xl border border-cant-line p-3">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-medium text-cant-muted uppercase"><%= t("order_chat.variant_label", letter: ("A".ord + i).chr) %></span>
          </div>
          <audio controls class="w-full h-8" preload="none">
            <source src="<%= asset.url.presence || asset.provider_url %>" type="audio/mpeg">
          </audio>
          <%= form_with url: order_chat_approve_music_path(order_id: order.id),
                        data: { turbo_stream: true },
                        class: "mt-2" do |f| %>
            <%= hidden_field_tag :variant, ("a".ord + asset.variant_index).chr %>
            <button type="submit"
                    class="w-full rounded-lg bg-cant-ink text-cant-paper py-1.5 text-xs font-medium hover:bg-cant-ink/90 transition">
              <%= t("order_chat.choose_variant_button", letter: ("A".ord + i).chr) %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <% unless order.music_regen_remaining.zero? %>
      <div class="mt-3" data-controller="regen-form">
        <input type="text"
               placeholder="<%= t('order_chat.regen_feedback_placeholder') %>"
               class="w-full rounded-xl border border-cant-line px-3 py-2 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-cant-ink/20 focus:border-cant-ink"
               data-regen-form-target="feedback">
        <%= form_with url: order_chat_regenerate_music_path(order_id: order.id),
                      data: { turbo_stream: true, action: "submit->regen-form#injectFeedback" } do |f| %>
          <input type="hidden" name="feedback" data-regen-form-target="hidden">
          <button type="submit"
                  class="w-full rounded-xl border border-cant-line text-cant-ink py-2 text-sm hover:bg-cant-ink/5 transition">
            <%= t("order_chat.regen_music_button", remaining: order.music_regen_remaining) %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
