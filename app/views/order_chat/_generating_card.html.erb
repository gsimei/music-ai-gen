<div id="<%= dom_id %>" class="flex justify-start">
  <div class="bg-white border border-cant-line rounded-2xl rounded-bl-sm px-5 py-4 max-w-[80%]">
    <div class="flex items-center gap-3">
      <div class="flex gap-1">
        <span class="w-2 h-2 rounded-full bg-cant-ink animate-bounce [animation-delay:0ms]"></span>
        <span class="w-2 h-2 rounded-full bg-cant-ink animate-bounce [animation-delay:150ms]"></span>
        <span class="w-2 h-2 rounded-full bg-cant-ink animate-bounce [animation-delay:300ms]"></span>
      </div>
      <span class="text-sm text-cant-muted"><%= message %></span>
    </div>
  </div>
</div>
