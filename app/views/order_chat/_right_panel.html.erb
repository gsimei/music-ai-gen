<% if order.campaign %>
  <%= render "order_chat/campaign_studio", order: order, draft: draft %>
<% else %>
<div id="chat-lyrics-panel" class="flex flex-col h-full overflow-hidden" data-controller="lyrics-sync">

  <% has_music  = order.preview_ready? || order.approved? %>
  <% has_lyrics = draft.present? %>

  <% if !has_lyrics && !has_music && !order.music_generating? %>
    <%# ── Empty state ──────────────────────────────────────────────────── %>
    <div class="studio-preview-empty">
      <div class="text-center">
        <div class="studio-mini-record" aria-hidden="true"><span>JP</span></div>
        <h2>Sua campanha<br>ganha voz.</h2>
        <p class="text-xs text-cant-muted"><%= t("order_chat.lyrics_panel_empty") %></p>
      </div>
    </div>

  <% else %>

    <% if order.music_generating? && !has_music %>
      <%# ── Generating music (top, no assets yet) ────────────────────── %>
      <div class="<%= has_lyrics ? 'flex-1 border-b border-cant-line' : 'flex-1' %> flex flex-col items-center justify-center gap-3">
        <div class="flex gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-cant-ink animate-bounce [animation-delay:0ms]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-cant-ink animate-bounce [animation-delay:150ms]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-cant-ink animate-bounce [animation-delay:300ms]"></span>
        </div>
        <p class="text-xs text-cant-muted"><%= t("order_chat.generating_music") %></p>
      </div>

    <% elsif has_music %>
      <%# ── Music section (top) ──────────────────────────────────────── %>
      <div class="<%= has_lyrics ? 'flex-1 border-b border-cant-line overflow-y-auto' : 'flex-1 overflow-y-auto' %>">
        <div class="px-5 py-3 border-b border-cant-line flex items-center justify-between sticky top-0 bg-white z-10">
          <% if order.approved? %>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-xs font-semibold text-cant-ink uppercase tracking-wide"><%= t("order_chat.music_ready_label") %></span>
            </div>
          <% else %>
            <span class="text-xs font-semibold text-cant-muted uppercase tracking-wide"><%= t("order_chat.music_preview_label") %></span>
            <span class="text-xs text-cant-muted"><%= t("order_chat.music_choose_variant") %></span>
          <% end %>
        </div>

        <div class="px-5 py-4 space-y-3">
          <% if order.approved? %>
            <% approved_asset = approved_music_asset(order) %>
            <% audio_url = approved_asset&.url.presence || approved_asset&.provider_url %>
            <% if audio_url.present? %>
              <audio controls class="w-full" preload="none"
                     data-lyrics-sync-target="audio"
                     data-lyrics-sections="<%= (approved_asset&.lyrics_sync&.dig("sections") || []).to_json %>">
                <source src="<%= audio_url %>" type="audio/mpeg">
              </audio>
              <%= link_to t("order_chat.download_button"), audio_url,
                    class: "flex items-center justify-center gap-2 w-full rounded-xl bg-cant-ink text-cant-paper py-2.5 text-sm font-medium hover:bg-cant-ink/90 transition mt-3",
                    download: true, target: "_blank" %>
            <% end %>
          <% else %>
            <% assets.each_with_index do |asset, i| %>
              <div class="rounded-xl border border-cant-line p-3">
                <p class="text-xs font-semibold text-cant-muted uppercase mb-2">
                  <%= t("order_chat.variant_label", letter: ("A".ord + i).chr) %>
                </p>
                <audio controls class="w-full mb-2" preload="none"
                       data-lyrics-sync-target="audio"
                       data-lyrics-sections="<%= (asset.lyrics_sync&.dig("sections") || []).to_json %>">
                  <source src="<%= asset.url.presence || asset.provider_url %>" type="audio/mpeg">
                </audio>
                <%= form_with url: order_chat_approve_music_path(order_id: order.id), data: { turbo_stream: true } do |f| %>
                  <%= hidden_field_tag :variant, ("a".ord + asset.variant_index).chr %>
                  <button type="submit" class="w-full rounded-lg bg-cant-ink text-cant-paper py-1.5 text-xs font-medium hover:bg-cant-ink/90 transition">
                    <%= t("order_chat.choose_variant_button", letter: ("A".ord + i).chr) %>
                  </button>
                <% end %>
              </div>
            <% end %>

            <% unless order.music_regen_remaining.zero? %>
              <div data-controller="regen-form">
                <input type="text"
                       placeholder="<%= t('order_chat.regen_feedback_placeholder') %>"
                       class="w-full rounded-xl border border-cant-line px-3 py-2 text-xs mb-2 focus:outline-none focus:ring-2 focus:ring-cant-ink/20 focus:border-cant-ink"
                       data-regen-form-target="feedback">
                <%= form_with url: order_chat_regenerate_music_path(order_id: order.id),
                              data: { turbo_stream: true, action: "submit->regen-form#injectFeedback" } do |f| %>
                  <input type="hidden" name="feedback" data-regen-form-target="hidden">
                  <button type="submit" class="w-full rounded-xl border border-cant-line text-cant-ink py-2 text-xs hover:bg-cant-ink/5 transition">
                    <%= t("order_chat.regen_music_button", count: order.music_regen_remaining, remaining: order.music_regen_remaining) %>
                  </button>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if has_lyrics %>
      <%# ── Lyrics section (bottom) ──────────────────────────────────── %>
      <%# When music is available, use Mureka's exact words so DOM indices match sync timestamps %>
      <% mureka_lines = [] %>
      <% if has_music %>
        <% sync_asset = order.approved? \
             ? approved_music_asset(order) \
             : assets.first %>
        <% mureka_lines = (sync_asset&.lyrics_sync&.dig("sections") || []).flat_map { |s| s["lines"] || [] } %>
      <% end %>

      <div class="<%= (has_music || order.music_generating?) ? 'h-2/5 shrink-0' : 'flex-1' %> studio-lyrics-sheet flex flex-col overflow-hidden bg-cant-ink">
        <div class="px-5 py-3 border-b border-white/10 flex items-center justify-between shrink-0">
          <span class="text-xs font-semibold text-white/40 uppercase tracking-wide"><%= t("order_chat.lyrics_panel_title") %></span>
          <span class="text-xs text-white/30">v<%= draft.version %></span>
        </div>
        <div class="flex-1 overflow-y-auto px-5 py-4 space-y-1">
          <% if mureka_lines.any? %>
            <% mureka_lines.each do |line| %>
              <% words = line["words"] || [] %>
              <% if words.empty? %>
                <div class="h-3"></div>
              <% else %>
                <p class="text-base font-sans leading-relaxed py-0.5"
                   data-lyrics-sync-target="line">
                  <% words.each do |word| %>
                    <span class="text-white/40 transition-colors duration-100"
                          data-lyrics-sync-target="word"><%= word["text"] %> </span>
                  <% end %>
                </p>
              <% end %>
            <% end %>
          <% else %>
            <% draft.content.split("\n").each do |line| %>
              <% if line.strip.empty? %>
                <div class="h-3"></div>
              <% else %>
                <p class="text-base font-sans leading-relaxed py-0.5"
                   data-lyrics-sync-target="line">
                  <% line.split(" ").each do |word| %>
                    <span class="text-white/40 transition-colors duration-100"
                          data-lyrics-sync-target="word"><%= word %> </span>
                  <% end %>
                </p>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  <% end %>

</div>

<% end %>
