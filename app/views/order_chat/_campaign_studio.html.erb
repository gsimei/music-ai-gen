<% completed = order.completed_music_rounds %>
<% busy = order.paid? || order.lyrics_drafting? || order.music_generating? || order.lyrics_approved? || order.lyrics_revision_token.present? %>
<% phase = Campaigns::StudioPhase.for(order) %>
<% selected = order.campaign.selected_music_asset if phase == :video %>
<% video_step = selected.present? || order.approved? %>
<div id="chat-lyrics-panel" class="creative-studio" data-controller="creative-editor" data-creative-editor-busy-value="<%= busy %>" data-creative-editor-view-value="<%= phase %>">
  <%= render "order_chat/studio/head", order: order, phase: phase %>
  <div id="creative-errors" class="creative-errors" role="alert" tabindex="-1"><%= order.lyrics_revision_error %></div>
  <% if @creation_notice.present? %><p class="creative-working" role="status"><%= @creation_notice %></p><% end %>
  <header class="creative-progress">
    <h1 tabindex="-1"><%= if order.approved?
      order.campaign.video_status == "ready" ? "Seu vídeo está pronto." : "Estamos montando seu vídeo."
    elsif selected
      "Vamos preparar seu vídeo."
    elsif completed.positive?
      "Ouça e escolha sua música."
    else
      "Vamos criar sua música."
    end %></h1>
    <p><%= video_step ? "Confira o resultado e ajuste o que quiser." : completed.positive? ? "Ouça as opções. Você pode ajustar a letra e o som antes de escolher." : "Confira o nome, o preço e as informações da sua oferta. Você pode ajustar a letra antes e depois de ouvir." %></p>
  </header>
  <%# ponytail: cada fase ainda renderiza os partials atuais; as tarefas 5 a 7 os trocam. %>
  <% case phase %>
  <% when :rendering, :failed_video, :delivered %>
    <%= render "campaigns/delivery", campaign: order.campaign %>
  <% when :video %>
    <%= render "order_chat/video_setup", order: order, asset: selected %>
  <% else %>
    <% if busy %>
      <% latest_attempt = order.music_generations.order(:iteration).last %>
      <% notes = [] %>
      <% notes << "O serviço de música está ocupado. Vamos tentar novamente em instantes, com um limite de tentativas." if latest_attempt&.error_code == "rate_limited" %>
      <% notes << "Sua música já foi solicitada. Estamos recuperando a resposta, sem gerar outra versão." if latest_attempt&.error_code == "status_unavailable" %>
      <% if order.paid? || order.lyrics_drafting? %>
        <%= render "order_chat/studio/wait", title: "Preparando sua letra…", detail: "Leva poucos instantes. Você pode sair e voltar pela Biblioteca.", notes: notes %>
      <% elsif order.lyrics_revision_token.present? %>
        <%= render "order_chat/studio/wait", title: "Reescrevendo sua letra…", detail: "Leva poucos instantes. Sua letra atual continua salva.", notes: notes %>
      <% else %>
        <%= render "order_chat/studio/wait", title: completed.positive? ? "Criando duas novas versões…" : "Criando duas versões…",
              detail: "Costuma levar de 1 a 2 minutos. Você pode sair e voltar pela Biblioteca.#{' Você pode ouvir as anteriores enquanto espera.' if completed.positive?}", notes: notes %>
      <% end %>
    <% end %>
    <%= render "order_chat/creation_status", order: order %>
    <% generations = order.music_generations.completed.includes(:order_assets, :lyrics_draft).order(iteration: :desc).to_a %>
    <% if generations.any? %>
      <%= render "order_chat/music_choices", order: order, generation: generations.first, number: completed, busy: busy %>
    <% end %>
    <% if draft && order.lyrics_editable? && completed < Campaigns::MusicRounds::LIMIT %>
      <% if completed.positive? %>
        <details id="creation-adjustments" class="creative-details creative-adjustments">
          <summary>Quero ajustar a letra ou a música</summary>
          <p>As alterações serão usadas nas próximas músicas. As anteriores continuam disponíveis.</p>
          <%= render "order_chat/creation_form", order: order, draft: draft, completed: completed %>
        </details>
      <% else %>
        <%= render "order_chat/creation_form", order: order, draft: draft, completed: completed %>
      <% end %>
    <% elsif completed >= Campaigns::MusicRounds::LIMIT %>
      <p class="campaign-note">Você já criou todas as músicas incluídas. Ouça e escolha qualquer opção, inclusive as anteriores.</p>
    <% elsif draft && busy %>
      <details id="creation-lyrics" class="creative-details"><summary>Ver a letra</summary><pre><%= draft.content %></pre></details>
    <% end %>
    <% if generations.size > 1 %>
      <details id="previous-music" class="creative-details jp-round-history">
        <summary>Ouvir opções anteriores</summary>
        <% generations.drop(1).each_with_index do |generation, index| %>
          <%= render "order_chat/music_choices", order: order, generation: generation, number: completed - index - 1, busy: busy %>
        <% end %>
      </details>
    <% end %>
  <% end %>
</div>
