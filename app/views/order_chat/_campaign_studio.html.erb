<% busy = order.paid? || order.lyrics_drafting? || order.music_generating? || order.lyrics_approved? || order.lyrics_revision_token.present? %>
<% phase = Campaigns::StudioPhase.for(order) %>
<% delivery = phase.in?(%i[rendering failed_video delivered]) %>
<div id="chat-lyrics-panel" data-controller="creative-editor" data-creative-editor-busy-value="<%= busy %>" data-creative-editor-view-value="<%= phase %>" data-phase="<%= Campaigns::StudioPhase.step(phase) %>">
  <%# Na montagem/Entrega a barra e o h1 vêm de campaigns/_delivery, igual em campaigns/show (R7). %>
  <% unless delivery %><%= render "order_chat/studio/head", order: order, phase: phase %><% end %>
  <div id="creative-errors" class="creative-errors" role="alert" tabindex="-1"><%= order.lyrics_revision_error %></div>
  <% if @creation_notice.present? %><p class="creative-working" role="status"><%= @creation_notice %></p><% end %>
  <% case phase %>
  <% when :lyrics %>
    <%= render "order_chat/studio/lyrics_phase", order: order, draft: draft %>
  <% when :rendering, :failed_video, :delivered %>
    <%= render "campaigns/delivery", campaign: order.campaign %>
  <% when :video %>
    <%= render "order_chat/studio/video_phase", order: order, asset: order.campaign.selected_music_asset %>
  <% else %>
    <%= render "order_chat/studio/music_phase", order: order, draft: draft, busy: busy %>
  <% end %>
</div>
