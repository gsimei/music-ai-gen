<section class="creative-round" aria-label="Músicas da geração <%= number %>">
  <% if number < order.completed_music_rounds %><h2>Geração <%= number %></h2><% end %>
  <div class="jp-versions">
    <% generation.order_assets.select(&:music_variant?).sort_by(&:variant_index).each do |asset| %>
      <article class="creative-version" id="music-version-<%= asset.id %>">
        <div class="creative-version-heading"><strong>Opção <%= ("A".ord + asset.variant_index).chr %></strong></div>
        <%= render "order_chat/music_audition", order: order, asset: asset, video: false %>
        <% if !busy && asset.audition_ready? %>
          <div class="creative-version-actions"><%= button_to "Usar esta música", order_chat_select_music_path(order_id: order.id), params: { asset_id: asset.id }, class: "studio-button studio-button-green", data: { turbo_stream: true } %></div>
        <% end %>
      </article>
    <% end %>
  </div>
  <details id="generation-lyrics-<%= generation.id %>" class="creative-details"><summary>Ver a letra destas músicas</summary><pre><%= generation.lyrics_draft&.content %></pre></details>
</section>
