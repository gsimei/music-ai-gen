<%# locals: (order:, draft:) %>
<%# Fase 1 · Letra. Um só form para order_chat#creation: "Salvar letra" (save), "Reescrever com IA" (rewrite) e o botão
    principal (generate, que salva o texto editado e aprova). O som vai em campaign[...] no mesmo form. Os ids
    lyrics-changes, rewrite-lyrics e creation-sound são os que o creative-editor reabre depois de um broadcast. %>
<% completed = order.completed_music_rounds %>
<% limit = Campaigns::MusicRounds::LIMIT %>
<section class="ui-phase" aria-labelledby="lyrics-phase-title">
  <p class="ui-eyebrow">Fase 1 de 3</p>
  <h2 id="lyrics-phase-title" class="ui-phase-title">Revise a letra.</h2>
  <% if order.lyrics_failed? %>
    <div class="ui-alert" role="alert">
      <div>
        <strong>Não conseguimos preparar a letra.</strong>
        <p>Seus dados estão salvos. Tente novamente.</p>
        <%= button_to "Tentar preparar a letra novamente", retry_generation_campaign_path(order.campaign), class: "ui-btn", form_class: "ui-phase-actions" %>
      </div>
    </div>
  <% elsif order.paid? || order.lyrics_drafting? %>
    <%= render "order_chat/studio/wait", title: "Preparando sua letra…", detail: "Leva poucos instantes. Você pode sair e voltar pela Biblioteca." %>
  <% elsif order.lyrics_revision_token.present? %>
    <%= render "order_chat/studio/wait", title: "Reescrevendo sua letra…", detail: "Leva poucos instantes. Sua letra atual continua salva." %>
    <% if draft %><details id="creation-lyrics" class="ui-more-box"><summary>Ver a letra</summary><pre class="ui-lyrics-text"><%= draft.content %></pre></details><% end %>
  <% elsif draft && order.lyrics_editable? %>
    <p class="ui-lead">Confira o nome, o preço e as condições. Editar não gasta rodada.</p>
    <%= form_with url: order_chat_creation_path(order_id: order.id), class: "ui-lyrics-form",
          data: { turbo_stream: true, action: "input->creative-editor#feedbackChanged change->creative-editor#feedbackChanged turbo:submit-end->creative-editor#restoreChanges" } do %>
      <%= hidden_field_tag :draft_id, draft.id %>
      <div class="ui-field">
        <%= label_tag "editable-lyrics", "Letra · versão #{draft.version}", class: "ui-label" %>
        <%= text_area_tag :content, draft.content, id: "editable-lyrics", rows: 10, maxlength: 5000, required: true,
              class: "ui-input ui-lyrics", aria: { describedby: "lyrics-help" } %>
        <p id="lyrics-help" class="ui-hint">Prefira letras curtas e confira se a oferta está completa.</p>
        <button type="submit" name="intent" value="save" class="ui-btn ui-btn-ghost">Salvar letra</button>
      </div>

      <details id="lyrics-changes" class="ui-more-box">
        <summary>Quero mudar algo</summary>
        <% unless order.lyrics_regen_exhausted? %>
          <details id="rewrite-lyrics" class="ui-more-box">
            <summary>Pedir para a IA reescrever</summary>
            <div class="ui-field">
              <%= label_tag :lyrics_feedback, "O que você quer mudar na letra?", class: "ui-label" %>
              <%= text_area_tag :lyrics_feedback, nil, rows: 2, maxlength: 1000, class: "ui-input ui-notes",
                    placeholder: "Ex.: mantenha a oferta e deixe o refrão mais curto." %>
              <p class="ui-hint">Você confere o novo texto antes de aprovar.</p>
              <button type="submit" name="intent" value="rewrite" class="ui-btn ui-btn-ghost">Reescrever com IA · <%= order.lyrics_regen_remaining %> ajustes</button>
            </div>
          </details>
        <% end %>
        <% catalog = Campaigns::GenreSamples.catalog %>
        <%= tag.details id: "creation-sound", class: "ui-more-box",
              data: { controller: "genre-preview", genre_preview_catalog_value: catalog.to_json, action: "visibilitychange@document->genre-preview#visibilityChanged" } do %>
          <summary>Mudar o som · <%= order.campaign.sound_summary %></summary>
          <%# O genre-preview reescreve nome, descrição, duração e src ao trocar de ritmo (connect -> select). %>
          <% example = render("shared/ui/player", controller: "genre-preview", src: nil, title: "", description: "",
                eyebrow: "Ouça antes de escolher", note: "Exemplo com voz ilustrativa. Não gasta rodada.", label: "exemplo",
                error: "Não foi possível tocar o exemplo.", audio_action: "play->creative-editor#play") %>
          <%= fields_for :campaign, order.campaign do |sound| %>
            <%= render "shared/ui/sound_fields", f: sound, between: example %>
            <div class="ui-field">
              <%= sound.label :music_notes, "Detalhes do som (opcional)", class: "ui-label" %>
              <%= sound.text_area :music_notes, rows: 2, maxlength: 240, class: "ui-input ui-notes", placeholder: "Ex.: violão em destaque e voz suave." %>
            </div>
          <% end %>
          <p class="ui-hint">Salvar o som não gasta rodada.</p>
          <button type="submit" name="intent" value="save" class="ui-btn ui-btn-ghost">Salvar som</button>
        <% end %>
      </details>

      <div class="ui-phase-actions">
        <button type="submit" name="intent" value="generate" class="ui-btn ui-btn-primary" aria-describedby="lyrics-round-note">
          Aprovar letra e ouvir 2 versões
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </button>
        <p id="lyrics-round-note" class="ui-hint">Isso usa a rodada <%= completed + 1 %> de <%= limit %>.</p>
      </div>
    <% end %>
  <% end %>
</section>
