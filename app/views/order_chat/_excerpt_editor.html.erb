<% current_start = [asset.excerpt_start_seconds || asset.campaign_audio.blob.metadata.fetch("start_seconds", 0), asset.excerpt_max_start].min.to_f %>
<details id="video-excerpt" class="creative-details excerpt-editor" data-controller="audio-excerpt" data-audio-excerpt-duration-value="<%= asset.track_duration_seconds %>"
  data-audio-excerpt-initial-photos-value="<%= Campaigns::PhotoLimit::INITIAL %>" data-audio-excerpt-max-photos-value="<%= Campaigns::PhotoLimit::MAX %>" data-audio-excerpt-photo-interval-value="<%= Campaigns::PhotoLimit::SECONDS_PER_PHOTO %>">
  <summary>Personalizar duração e trecho</summary>
  <p class="studio-field-hint">Esta música tem <%= campaign_media_time(asset.track_duration_seconds) %>. Escolha quanto dela vai entrar no vídeo e onde começar.</p>
  <%= form_with url: order_chat_excerpt_settings_path(order_id: order.id), method: :patch,
    data: { turbo_stream: true, action: "input->creative-editor#feedbackChanged change->creative-editor#feedbackChanged turbo:submit-end->creative-editor#restoreChanges" } do %>
    <%= hidden_field_tag :asset_id, asset.id %>
    <%= hidden_field_tag :preview_revision, asset.preview_revision %>
    <%= label_tag "excerpt-duration-#{asset.id}", "Duração do vídeo" %>
    <%= select_tag :duration_seconds, options_for_select(campaign_duration_options(asset), campaign_duration_selection(asset)),
      id: "excerpt-duration-#{asset.id}", data: { audio_excerpt_target: "length", action: "change->audio-excerpt#durationChanged" } %>
    <div data-audio-excerpt-target="customField" class="excerpt-custom-duration">
      <%= label_tag "excerpt-custom-duration-#{asset.id}", "Duração personalizada em segundos" %>
      <%= number_field_tag :custom_duration_seconds, asset.video_duration_seconds.floor(2), min: 1, max: asset.track_duration_seconds.floor(2), step: 0.01,
        id: "excerpt-custom-duration-#{asset.id}", data: { audio_excerpt_target: "customLength", action: "input->audio-excerpt#durationChanged" } %>
    </div>
    <%= label_tag "excerpt-range-#{asset.id}", "Início do trecho" %>
    <%= range_field_tag nil, current_start, min: 0, max: asset.excerpt_max_start, step: 0.01, id: "excerpt-range-#{asset.id}", data: { audio_excerpt_target: "slider", action: "input->audio-excerpt#slide" } %>
    <div class="excerpt-time-input"><%= label_tag "excerpt-seconds-#{asset.id}", "Segundo inicial" %><%= number_field_tag :start_seconds, current_start, min: 0, max: asset.excerpt_max_start, step: 0.01, required: true, id: "excerpt-seconds-#{asset.id}", data: { audio_excerpt_target: "seconds", action: "input->audio-excerpt#type" } %></div>
    <p class="studio-field-hint" data-audio-excerpt-target="summary" role="status"></p>
    <button type="submit" class="studio-button studio-button-outline">Preparar e ouvir este trecho</button>
    <button type="submit" name="automatic" value="1" class="creative-favorite-button" formnovalidate>Voltar ao trecho sugerido</button>
    <p class="studio-field-hint">Ajustar a duração usa a música já criada e não gasta uma rodada musical. Prepare e ouça o resultado antes de gerar o vídeo.</p>
  <% end %>
</details>
