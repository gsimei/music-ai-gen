<% if order.tier_config&.dig(:includes_soundtrack) %>
  <div class="shrink-0 flex gap-1 px-4 pt-3 pb-0 bg-white border-b border-cant-line"
       role="tablist"
       aria-label="<%= t('order_chat.mode_tabs_label') %>">

    <button type="button"
            role="tab"
            aria-selected="true"
            aria-controls="chat-messages"
            data-chat-mode-target="tab"
            data-mode="music"
            data-action="click->chat-mode#switch"
            class="chat-tab chat-tab--active relative px-4 py-2 text-sm font-semibold rounded-t-lg border border-b-0 border-cant-line bg-cant-paper text-cant-ink transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cant-ink">
      <%= t('order_chat.tab_music') %>
    </button>

    <button type="button"
            role="tab"
            aria-selected="false"
            aria-controls="chat-messages"
            data-chat-mode-target="tab"
            data-mode="soundtrack"
            data-action="click->chat-mode#switch"
            class="chat-tab relative px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 border-transparent text-cant-muted hover:text-cant-ink transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cant-ink">
      Soundtrack
    </button>

  </div>
<% end %>
