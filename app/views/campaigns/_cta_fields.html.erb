<%# locals: f. Faixa de contato do vídeo no estúdio: os chips de contato do Criar (rádios campaign[call_to_action],
    "Sem faixa de contato" com value "" e o hidden campaign[show_cta]) mais a cor da faixa. Os nomes de campo não mudam. %>
<%= render "campaigns/new/contact_chips", f: f, contact_strip: f.object.show_cta? %>
<div class="ui-field">
  <%= f.label :cta_color, "Cor da faixa", class: "ui-label" %>
  <div class="ui-color">
    <%= f.color_field :cta_color, value: f.object.cta_background_color, class: "ui-color-input", aria: { describedby: "#{f.field_id(:cta_color)}-help" },
          data: { campaign_form_target: "ctaColor", action: "input->campaign-form#previewCta change->campaign-form#previewCta" } %>
    <p id="<%= f.field_id(:cta_color) %>-help" class="ui-hint">Escolha a cor da sua marca. O texto se ajusta para ficar legível.</p>
  </div>
</div>
