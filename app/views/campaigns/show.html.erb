<% content_for :title, "#{@campaign.title} · #{brand_name}" %>
<% content_for :body_class, "studio-page" %>
<%= turbo_stream_from "campaign_#{@campaign.id}" %>
<% order = @campaign.order %>
<div class="studio-home estudio">
  <%= render "shared/studio_header" %>
  <main class="ui-main"><%= render "shared/studio_flash" %>
    <div class="ui-project">
      <div><p class="ui-kicker">Sua campanha · <%= order.reference %></p><strong><%= @campaign.title %></strong></div>
      <% if @campaign.logo.attached? %><%= image_tag @campaign.logo, alt: "Logo da empresa", class: "ui-project-logo" %><% end %>
    </div>
    <% if order.approved? %>
      <%= render "campaigns/delivery", campaign: @campaign %>
      <%= render "campaigns/music_profile", campaign: @campaign %>
    <% else %>
      <%= render "order_chat/studio/head", order: order, phase: Campaigns::StudioPhase.for(order), counters: false %>
      <section class="ui-phase" aria-labelledby="campaign-progress-title">
        <h1 id="campaign-progress-title" class="ui-phase-title">Sua campanha está em criação.</h1>
        <p class="ui-lead">Revise a letra, ouça as opções e escolha a sua música. Depois, confira as fotos e gere seu vídeo.</p>
        <%= link_to "Acompanhar e escolher a música", order_chat_path(order_id: @campaign.order_id), class: "ui-btn ui-btn-primary" %>
      </section>
    <% end %>
  </main>
</div>
