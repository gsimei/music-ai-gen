<% content_for :title, "#{@campaign.business_name} · JinglePro" %>
<% content_for :body_class, "studio-page" %>
<%= turbo_stream_from "campaign_#{@campaign.id}" %>
<div class="studio-home studio-app campaign-app"><%= render "shared/studio_header" %>
  <main class="campaign-main"><%= render "shared/studio_flash" %>
    <div class="campaign-heading"><p class="studio-kicker">SUA CAMPANHA / <%= @campaign.order.reference %></p><h1><%= @campaign.business_name %><% unless @campaign.order.approved? %><br><span><%= (@campaign.order.pending? || @campaign.order.payment_failed?) ? "Confira sua promoção." : "Sua campanha está a caminho." %></span><% end %></h1></div>
    <% if @campaign.order.pending? || @campaign.order.payment_failed? %>
      <% if @campaign.order.payment_failed? %><div class="studio-notice studio-error" role="alert"><strong>O pagamento não foi concluído.</strong><p>Sua promoção e suas fotos estão salvas. Confira o cartão ou tente outro meio de pagamento para continuar.</p></div><% end %>
      <% if params[:payment] == "processing" && !@campaign.order.payment_failed? %><div class="campaign-note" role="status"><strong><%= @payment_check_unavailable ? "A confirmação está demorando um pouco." : "Aguardando a confirmação do pagamento." %></strong><p>Se você acabou de pagar, não precisa pagar novamente. A confirmação pode levar alguns instantes.</p><%= link_to "Verificar confirmação", campaign_path(@campaign, payment: "processing"), class: "studio-text-link" %></div><% end %>
      <div class="campaign-checkout"><section class="campaign-card"><p class="studio-kicker">CONFIRA A SUA PROMOÇÃO</p><h2><%= @campaign.offer %></h2><p><%= @campaign.call_to_action %>: <%= @campaign.contact %></p><p>Direção da música: <strong><%= @campaign.sound_summary %></strong> · Português do Brasil</p><% if @campaign.product_photos.any? %><div class="campaign-photo-list"><% @campaign.product_photos.each_with_index do |photo, index| %><figure><%= image_tag photo, alt: "Foto #{index + 1} da promoção" %><figcaption><%= index.zero? ? "1 · Abre o vídeo" : "#{index + 1} · Foto" %></figcaption></figure><% end %></div><p class="studio-field-hint">O vídeo segue esta ordem, com transições suaves.</p><% end %><% if @campaign.order.stripe_session_id.blank? %><%= link_to "Editar os dados", edit_campaign_path(@campaign), class: "studio-text-link" %><% end %></section>
      <aside class="campaign-card"><p class="studio-kicker">CAMPANHA COMPLETA</p><div class="campaign-total"><strong><%= campaign_price(@campaign.order) %></strong><span>pagamento único</span></div><ul class="campaign-included"><li>Letra editável e favorita salva</li><li>Até 3 rodadas com 2 versões cada</li><li>Vídeo vertical + MP3 + legenda</li></ul><% unless params[:payment] == "processing" && !@campaign.order.payment_failed? %><%= button_to "Pagar #{campaign_price(@campaign.order)} e criar campanha", checkout_order_path(@campaign.order), class: "studio-button studio-button-green", data: { turbo: false } %><% end %><p class="studio-field-hint">Pagamento pelo Stripe. A criação começa após a confirmação. Você acompanha tudo por aqui.</p>
      <% if Rails.env.development? %><details class="campaign-local-test"><summary>Ambiente local de desenvolvimento</summary><p>Simula a confirmação sem cobrar. Disponível somente neste ambiente.</p><%= button_to "Testar sem cobrança", test_payment_campaign_path(@campaign), class: "studio-button studio-button-outline" %></details><% end %></aside></div>
    <% elsif @campaign.order.approved? %>
      <%= render "campaigns/delivery", campaign: @campaign %>
    <% else %>
      <section class="campaign-card"><h2>Sua campanha está em criação.</h2><p>Revise a letra, ouça as opções e escolha a sua música. Depois, montamos o vídeo automaticamente.</p><%= link_to "Acompanhar e escolher a música", order_chat_path(order_id: @campaign.order_id), class: "studio-button studio-button-green" %></section>
    <% end %>
    <% if @campaign.order.pending? || @campaign.order.approved? %><%= render "campaigns/music_profile", campaign: @campaign %><% end %>
  </main>
</div>
