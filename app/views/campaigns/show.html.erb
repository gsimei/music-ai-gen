<% content_for :title, "#{@campaign.title} · #{brand_name}" %>
<% content_for :body_class, "studio-page" %>
<%= turbo_stream_from "campaign_#{@campaign.id}" %>
<div class="studio-home studio-app campaign-app"><%= render "shared/studio_header" %>
  <main class="campaign-main"><%= render "shared/studio_flash" %>
    <div class="campaign-heading"><p class="studio-kicker">SUA CAMPANHA / <%= @campaign.order.reference %></p><% if @campaign.logo.attached? %><%= image_tag @campaign.logo, alt: "Logo da empresa", class: "jp-summary-logo" %><% end %><h1><%= @campaign.title %><% unless @campaign.order.approved? %><br><span>Sua campanha está a caminho.</span><% end %></h1></div>
    <% if @campaign.order.approved? %>
      <%= render "campaigns/delivery", campaign: @campaign %>
    <% else %>
      <section class="campaign-card"><h2>Sua campanha está em criação.</h2><p>Revise a letra, ouça as opções e escolha a sua música. Depois, confira as fotos e gere seu vídeo.</p><%= link_to "Acompanhar e escolher a música", order_chat_path(order_id: @campaign.order_id), class: "studio-button studio-button-green" %></section>
    <% end %>
    <% if @campaign.order.approved? %><%= render "campaigns/music_profile", campaign: @campaign %><% end %>
  </main>
</div>
