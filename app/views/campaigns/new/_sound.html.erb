<%# locals: f. Passo 2: ritmo (tiles), cartão do player, voz (segmentado), clima (chips) e detalhes. O escopo genre-preview é a própria section:
    os tiles, o cartão e o <audio> dividem o mesmo controller. O catálogo tolera item sem duration_seconds e catálogo vazio. %>
<% catalog = Campaigns::GenreSamples.catalog %>
<% notes_open = f.object.music_notes.present? %>
<%= tag.section class: "ui-step ui-step-sound", data: { campaign_form_target: "step", controller: "genre-preview", genre_preview_catalog_value: catalog.to_json,
      action: "change->campaign-form#sound visibilitychange@document->genre-preview#visibilityChanged" } do %>
  <p class="ui-eyebrow">Sua música</p>
  <h2>Como sua promoção deve <em>soar?</em></h2>
  <p class="ui-lead">Escolha o ritmo e a voz. A música será cantada em português, com a sua oferta.</p>

  <%= render "shared/ui/sound_fields", f: f, between: render("campaigns/new/player", campaign: f.object, catalog: catalog) %>

  <div class="ui-field ui-details">
    <div class="ui-details-row">
      <button type="button" class="ui-more" aria-expanded="<%= notes_open %>" aria-controls="campaign-sound-details" data-action="campaign-form#toggleDetails"><span aria-hidden="true"><%= notes_open ? "−" : "+" %></span> Detalhes do som</button>
      <span class="ui-optional">Opcional</span>
    </div>
    <div id="campaign-sound-details" class="ui-field" <%= "hidden" unless notes_open %>>
      <%= f.label :music_notes, "Detalhes do som", class: "ui-label" %>
      <%= f.text_area :music_notes, rows: 3, maxlength: 240, class: "ui-input ui-notes", placeholder: "Ex.: sanfona em destaque, voz suave, refrão fácil de cantar. Sem solos longos.", aria: criar_field_aria(f.object, :music_notes, "campaign-notes-help") %>
      <p id="campaign-notes-help" class="ui-hint">Descreva os instrumentos, a interpretação ou o que prefere evitar. Até 240 caracteres.</p>
      <%= criar_field_error(f.object, :music_notes) %>
    </div>
  </div>

  <p class="ui-note">Você poderá revisar a letra e essas escolhas antes da primeira geração. Depois, ouvirá duas versões para comparar.</p>
<% end %>
