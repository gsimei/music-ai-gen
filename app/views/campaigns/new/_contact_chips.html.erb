<%# locals: f, contact_strip. Rádios nativos (campaign[call_to_action]) como chips; "Sem faixa de contato" tem value "".
    O hidden show_cta carrega "1"/"0" literal e o JS (chooseCta) o mantém em sincronia com o chip marcado. %>
<%
  icons = {
    "Peça pelo WhatsApp" => "M21 12a8.5 8.5 0 0 1-12.4 7.5L3 21l1.5-5.2A8.5 8.5 0 1 1 21 12Z",
    "Venha nos visitar" => "M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
    "Reserve seu horário" => "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 4.5V12l3 2",
    "Saiba mais no Instagram" => "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm4 5.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5.2-1.7h.01",
    "" => "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM5.6 5.6l12.8 12.8"
  }
  generic_icon = "m12 3 2.7 5.6 6.1.8-4.5 4.3 1.1 6.1L12 16.8 6.6 19.8l1.1-6.1L3.2 9.4l6.1-.8Z"
  saved_option = f.object.call_to_action.to_s
  extra = contact_strip && Campaign::CTA_OPTIONS.exclude?(saved_option) ? saved_option : nil
  options = Campaign::CTA_OPTIONS + [ extra ].compact + [ "" ]
  checked_value = contact_strip ? saved_option : ""
  hint = campaign_contact_hint(saved_option.presence || Campaign::CTA_OPTIONS.first)
%>
<fieldset class="ui-field">
  <legend class="ui-label">Como o cliente fala com você?</legend>
  <div class="ui-chips">
    <% options.each do |value| %>
      <% chip_hint = campaign_contact_hint(value) %>
      <label class="ui-chip">
        <%= f.radio_button :call_to_action, value, checked: value == checked_value,
          data: { campaign_form_target: "ctaChoice", action: "change->campaign-form#chooseCta", contact_placeholder: (chip_hint[:placeholder] if value.present?), contact_inputmode: (chip_hint[:inputmode] if value.present?) } %>
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="<%= icons.fetch(value, generic_icon) %>"/></svg>
        <span><%= value.presence || "Sem faixa de contato" %></span>
      </label>
    <% end %>
  </div>
  <%= hidden_field_tag "campaign[show_cta]", (contact_strip ? "1" : "0"), id: nil, data: { campaign_form_target: "ctaFlag" } %>
  <div class="ui-contact" data-campaign-form-target="ctaFields" <%= "hidden" unless contact_strip %>>
    <%= f.label :contact, "WhatsApp, endereço ou @Instagram", class: "ui-label" %>
    <%= f.text_field :contact, class: "ui-input", required: contact_strip, maxlength: 70, placeholder: hint[:placeholder], inputmode: hint[:inputmode], autocomplete: "off", aria: criar_field_aria(f.object, :contact), data: { campaign_form_target: "contact", action: "input->campaign-form#previewCta" } %>
    <%= criar_field_error(f.object, :contact) %>
  </div>
</fieldset>
