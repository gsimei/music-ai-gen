<% profile = current_user.business_music_profiles.find_by(business_key: BusinessMusicProfile.key_for(campaign.business_name)) if campaign.business_name.present? %>
<% settings = campaign.order.approved? ? campaign.order.approved_music_generation&.request_payload&.dig("sound_settings") : campaign.sound_settings %>
<% if campaign.business_name.present? && (settings.present? || profile) %>
<section class="ui-delivery-card is-dashed" aria-labelledby="saved-sound-title">
  <p class="ui-kicker">O som do seu negócio</p>
  <% if settings.present? %>
    <h2 id="saved-sound-title">Gostou desta direção musical?</h2>
    <p>Guarde o ritmo, a preferência de voz e o clima para a próxima promoção. A letra e a melodia serão novas.</p>
    <p class="ui-hint"><%= Campaign.new(settings.slice("musical_genre", "vocal_gender", "style", "music_notes")).sound_summary %></p>
    <%= button_to profile ? "Atualizar o som salvo do negócio" : "Salvar o som do meu negócio", save_music_profile_campaign_path(campaign), class: "ui-btn ui-btn-ghost" %>
  <% end %>
  <% if profile %><%= link_to "Criar promoção com esse som", new_campaign_path(music_profile_id: profile.id), class: "ui-link" %><% end %>
</section>
<% end %>
