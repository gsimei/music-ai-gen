<!DOCTYPE html>
<html lang="<%= I18n.locale == :pt ? "pt-BR" : I18n.locale %>">
  <head>
    <title><%= content_for(:title) || brand_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= brand_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="<%= content_for(:body_class).to_s.include?('studio-page') ? '#f6f5ed' : '#f5f1e7' %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/brand/musical/virajingle-icon.png" type="image/png">
    <link rel="icon" href="/brand/musical/virajingle-icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/brand/musical/virajingle-icon.png">

    <%# Design-system fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%# Stable load order: shared design system follows legacy compatibility styles %>
    <%= stylesheet_link_tag "tailwind", "application", "studio", "studio_app", "studio_identity", "landing", "jinglepro", "ui", "data-turbo-track": "reload" %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class).presence || "studio-page" %>">
    <div class="grain" aria-hidden="true"></div>
    <%# Flash messages rendered at top-level so they are available on every page.
        Individual views that need inline alerts handle them themselves via
        local notice/alert helpers. This outer wrapper is intentionally transparent
        so brand-specific pages can own the full viewport. %>
    <% if content_for?(:body_class) %>
      <%= yield %>
    <% else %>
      <div class="studio-home studio-app jp-legacy"><%= render "shared/studio_header" if user_signed_in? %><%= yield %></div>
    <% end %>
  </body>
</html>
