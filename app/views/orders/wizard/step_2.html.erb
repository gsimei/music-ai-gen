<% content_for :title, "JinglePro · Stile musicale" %>
<% @step = 2 %>

<% music_styles = [
  { value: "pop",         label: "Pop" },
  { value: "rock",        label: "Rock" },
  { value: "jazz",        label: "Jazz" },
  { value: "classica",    label: "Classica" },
  { value: "folk",        label: "Folk" },
  { value: "elettronica", label: "Elettronica" },
  { value: "hiphop",      label: "Hip-Hop" },
  { value: "country",     label: "Country" },
  { value: "rnb",         label: "R&B" },
  { value: "altro",       label: "Altro" }
] %>

<% mood_options = [
  { value: "allegro",     label: "Allegro" },
  { value: "romantico",   label: "Romantico" },
  { value: "energico",    label: "Energico" },
  { value: "malinconico", label: "Malinconico" },
  { value: "intimo",      label: "Intimo" },
  { value: "epico",       label: "Epico" }
] %>

<% tempo_options = [
  { value: "lento",  label: "Lento" },
  { value: "medio",  label: "Medio" },
  { value: "veloce", label: "Veloce" }
] %>

<% duration_options = [
  { value: "30",  label: "30 sec" },
  { value: "60",  label: "1 min" },
  { value: "90",  label: "1 min 30" },
  { value: "120", label: "2 min" }
] %>

<% language_options = [
  { value: "it", flag: "🇮🇹", label: "Italiano" },
  { value: "en", flag: "🇬🇧", label: "English" },
  { value: "pt", flag: "🇧🇷", label: "Português" },
  { value: "es", flag: "🇪🇸", label: "Español" },
  { value: "fr", flag: "🇫🇷", label: "Français" },
  { value: "de", flag: "🇩🇪", label: "Deutsch" }
] %>

<% saved = @wizard_session&.to_h || {} %>

<%= turbo_frame_tag "wizard", data: { turbo_action: "advance" } do %>
  <div class="wrap" style="padding-bottom:80px;">

    <div class="wzbar">
      <div class="lp">
        <svg class="mark" viewBox="0 0 64 70" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M52 12 C44 6, 36 4, 28 4 C14 4, 6 14, 6 32 C6 50, 14 60, 28 60 C36 60, 44 58, 52 52" stroke-linecap="square"/><path d="M22 32 H 48" stroke-linecap="square"/><circle cx="48" cy="32" r="2.6" fill="currentColor" stroke="none"/></svg>
        <span class="name">JinglePro</span>
      </div>
      <div class="meta">Passo 2 · 02 / 05</div>
    </div>

    <nav class="progress" aria-label="Progresso wizard">
      <% steps_meta = [
        { num: 1, short: "Info" },
        { num: 2, short: "Stile" },
        { num: 3, short: "Dettagli" },
        { num: 4, short: "Voce" },
        { num: 5, short: "Piano" }
      ] %>
      <% steps_meta.each do |s| %>
        <% state = s[:num] < @step ? "done" : s[:num] == @step ? "active" : "" %>
        <div class="pstep <%= state %>">
          <div class="bar"></div>
          <div class="meta">
            <span class="dot"></span>
            <span class="nm"><b>0<%= s[:num] %></b><%= s[:short] %></span>
          </div>
        </div>
      <% end %>
    </nav>

    <div class="wzhead reveal">
      <div class="eyebrow">Passo 2</div>
      <h2 class="display">Stile</h2>
      <p>Scegli il carattere musicale del tuo jingle.</p>
    </div>

    <% if @validator&.errors&.any? %>
      <div role="alert" class="callout show" style="margin-bottom:20px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
        <div>
          <% @validator.errors.each do |error| %>
            <div><%= error.full_message %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="wzbody">
      <%= form_with url: wizard_order_path(step: 2), method: :patch,
                    data: { turbo_frame: "wizard" } do |f| %>

        <div class="group reveal">
          <div class="gl">Genere musicale <span class="opt">*</span></div>
          <div class="pillrow" data-pillgroup role="group" aria-label="Genere musicale">
            <% music_styles.each do |style| %>
              <% checked = saved[:music_style].to_s == style[:value] %>
              <label class="pill <%= checked ? 'on' : '' %>">
                <input type="radio" name="order_wizard[music_style]" value="<%= style[:value] %>"
                       class="sr-only" <%= "checked" if checked %>>
                <%= style[:label] %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="group reveal">
          <div class="gl">Emozione / mood</div>
          <div class="pillrow" data-pillgroup role="group" aria-label="Mood">
            <% mood_options.each do |opt| %>
              <% checked = saved[:mood].to_s == opt[:value] %>
              <label class="pill <%= checked ? 'on' : '' %>">
                <input type="radio" name="order_wizard[mood]" value="<%= opt[:value] %>"
                       class="sr-only" <%= "checked" if checked %>>
                <%= opt[:label] %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="group reveal">
          <div class="gl">Tempo</div>
          <div class="pillrow" data-pillgroup role="group" aria-label="Tempo">
            <% tempo_options.each do |opt| %>
              <% checked = saved[:tempo].to_s == opt[:value] %>
              <label class="pill lg <%= checked ? 'on' : '' %>">
                <input type="radio" name="order_wizard[tempo]" value="<%= opt[:value] %>"
                       class="sr-only" <%= "checked" if checked %>>
                <%= opt[:label] %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="group reveal">
          <div class="gl">Durata</div>
          <div class="pillrow" data-pillgroup role="group" aria-label="Durata">
            <% duration_options.each do |opt| %>
              <% checked = saved[:target_duration_seconds].to_s == opt[:value] %>
              <label class="pill lg <%= checked ? 'on' : '' %>">
                <input type="radio" name="order_wizard[target_duration_seconds]" value="<%= opt[:value] %>"
                       class="sr-only" <%= "checked" if checked %>>
                <%= opt[:label] %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="group reveal">
          <div class="gl">Lingua della letra <span class="opt">*</span></div>
          <div class="langrow" role="group" aria-label="Lingua">
            <% language_options.each do |opt| %>
              <% checked = saved[:language].to_s == opt[:value] || (saved[:language].blank? && opt[:value] == "it") %>
              <label class="lang <%= checked ? 'on' : '' %>">
                <input type="radio" name="order_wizard[language]" value="<%= opt[:value] %>"
                       class="sr-only" <%= "checked" if checked %>>
                <span class="fl" aria-hidden="true"><%= opt[:flag] %></span> <%= opt[:label] %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="wzfoot between">
          <%= link_to "Indietro", wizard_order_path(step: 1),
              class: "btn btn-secondary",
              data: { turbo_frame: "wizard" } %>
          <span class="mag">
            <%= f.submit "Continua", class: "btn btn-primary" %>
          </span>
        </div>

      <% end %>
    </div>

  </div>
<% end %>
