<% @step = 3 %>
<% saved = @wizard_session&.to_h || {} %>

<%= turbo_frame_tag "wizard", data: { turbo_action: "advance" } do %>
  <div class="wrap" style="padding-bottom:80px;">

    <div class="wzbar">
      <div class="lp">
        <%= render "shared/studio_logo" %>
      </div>
      <div class="meta">Passo 3 · 03 / 05</div>
    </div>

    <nav class="progress" aria-label="Progresso wizard">
      <% steps_meta = [
        { num: 1, short: "Info" },
        { num: 2, short: "Stile" },
        { num: 3, short: "Dettagli" },
        { num: 4, short: "Voce" },
        { num: 5, short: "Piano" }
      ] %>
      <% steps_meta.each do |s| %>
        <% state = s[:num] < @step ? "done" : s[:num] == @step ? "active" : "" %>
        <div class="pstep <%= state %>">
          <div class="bar"></div>
          <div class="meta">
            <span class="dot"></span>
            <span class="nm"><b>0<%= s[:num] %></b><%= s[:short] %></span>
          </div>
        </div>
      <% end %>
    </nav>

    <div class="wzhead reveal">
      <div class="eyebrow">Passo 3 · Facoltativo</div>
      <h2 class="display">Dettagli</h2>
      <p>Passo facoltativo — puoi saltarlo.</p>
    </div>

    <div class="wzbody">
      <%= form_with url: wizard_order_path(step: 3), method: :patch,
                    data: { turbo_frame: "wizard" } do |f| %>

        <div class="field reveal">
          <label for="wizard_keywords">Parole chiave da includere</label>
          <p style="font-size:11px;color:var(--mute);margin-bottom:7px;" id="keywords-hint">
            Termini, slogan, nomi di prodotto che vuoi includere nella letra.
          </p>
          <%= f.text_area :keywords,
              name: "order_wizard[keywords]",
              id: "wizard_keywords",
              value: saved[:keywords],
              rows: 3,
              "aria-describedby": "keywords-hint",
              class: "textarea",
              placeholder: "Es: \"artigianale\", \"tradizione di famiglia\", \"Napoli\"…" %>
        </div>

        <div class="field reveal">
          <label for="wizard_avoid">Restrizioni o cose da evitare</label>
          <p style="font-size:11px;color:var(--mute);margin-bottom:7px;" id="avoid-hint">
            Toni, argomenti, stili o parole che non devono comparire.
          </p>
          <%= f.text_area :avoid,
              name: "order_wizard[avoid]",
              id: "wizard_avoid",
              value: saved[:avoid],
              rows: 3,
              "aria-describedby": "avoid-hint",
              class: "textarea",
              placeholder: "Es: nessun riferimento a concorrenti, no toni aggressivi…" %>
        </div>

        <div class="field reveal">
          <label for="wizard_structure_hint">Struttura preferita</label>
          <p style="font-size:11px;color:var(--mute);margin-bottom:7px;" id="structure-hint-desc">
            Suggerisci all'AI come strutturare il jingle.
          </p>
          <%= f.text_area :structure_hint,
              name: "order_wizard[structure_hint]",
              id: "wizard_structure_hint",
              value: saved[:structure_hint],
              rows: 2,
              "aria-describedby": "structure-hint-desc",
              class: "textarea",
              placeholder: "es: strofa - ritornello - strofa - outro" %>
        </div>

        <div class="wzfoot between">
          <%= link_to "Salta", wizard_order_path(step: 4),
              class: "btn btn-secondary",
              data: { turbo_frame: "wizard" } %>
          <span class="mag">
            <%= f.submit "Continua", class: "btn btn-primary" %>
          </span>
        </div>

      <% end %>
    </div>

  </div>
<% end %>
