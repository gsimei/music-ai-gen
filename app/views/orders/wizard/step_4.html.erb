<% @step = 4 %>
<% saved_voice_id = @wizard_session&.to_h&.dig(:voice_id)&.to_s %>

<%= turbo_frame_tag "wizard", data: { turbo_action: "advance" } do %>
  <div class="wrap" style="padding-bottom:80px;"
       data-controller="wizard-voice">

    <div class="wzbar">
      <div class="lp">
        <%= render "shared/studio_logo" %>
      </div>
      <div class="meta">Passo 4 · 04 / 05</div>
    </div>

    <nav class="progress" aria-label="Progresso wizard">
      <% steps_meta = [
        { num: 1, short: "Info" },
        { num: 2, short: "Stile" },
        { num: 3, short: "Dettagli" },
        { num: 4, short: "Voce" },
        { num: 5, short: "Piano" }
      ] %>
      <% steps_meta.each do |s| %>
        <% state = s[:num] < @step ? "done" : s[:num] == @step ? "active" : "" %>
        <div class="pstep <%= state %>">
          <div class="bar"></div>
          <div class="meta">
            <span class="dot"></span>
            <span class="nm"><b>0<%= s[:num] %></b><%= s[:short] %></span>
          </div>
        </div>
      <% end %>
    </nav>

    <div class="wzhead reveal">
      <div class="eyebrow">Passo 4</div>
      <h2 class="display">Voce</h2>
      <p>Ascolta un provino e scegli chi canterà.</p>
    </div>

    <% if @validator&.errors&.any? %>
      <div role="alert" class="callout show" style="margin-bottom:20px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
        <div>Scegli una voce per continuare.</div>
      </div>
    <% end %>

    <div class="wzbody" style="max-width:none;">
      <%= form_with url: wizard_order_path(step: 4), method: :patch,
                    data: { turbo_frame: "wizard" },
                    id: "voice-form" do |f| %>

        <%= f.hidden_field :voice_id,
            name: "order_wizard[voice_id]",
            id: "wizard_voice_id",
            value: saved_voice_id,
            data: { "wizard-voice-target": "input" } %>

        <div class="grid-3"
             role="radiogroup"
             aria-label="Seleziona una voce"
             style="margin-bottom:0;">
          <% @voices.each_with_index do |voice, i| %>
            <%
              is_selected = saved_voice_id == voice.id.to_s
              is_pro_only = voice.pro_only?
              tag_label = voice.gender == "male" ? "Maschio" : voice.gender == "female" ? "Femmina" : "Neutro"
            %>
            <div class="card voice <%= is_selected ? 'sel' : '' %> reveal"
                 data-wizard-voice-target="card"
                 data-voice-id="<%= voice.id %>"
                 data-pro="<%= is_pro_only ? '1' : '0' %>"
                 data-pro-only="<%= is_pro_only %>"
                 data-action="click->wizard-voice#select">

              <% if is_pro_only %>
                <span class="pro badge badge-brass" aria-label="Piano Pro richiesto">Pro</span>
              <% end %>

              <input type="radio"
                     name="voice_card_<%= voice.id %>"
                     value="<%= voice.id %>"
                     <%= "checked" if is_selected %>
                     class="sr-only"
                     aria-label="<%= voice.name %><%= is_pro_only ? ' (piano Pro)' : '' %>"
                     tabindex="0"
                     data-wizard-voice-target="radio">

              <div class="vtop">
                <div class="vname"><%= voice.name %></div>
                <button type="button" class="play" aria-label="Ascolta <%= voice.name %>"></button>
              </div>

              <div class="vtags">
                <span class="vtag"><%= tag_label %></span>
                <span class="vtag">IT</span>
                <% if voice.mood_tags.any? %>
                  <span class="vtag"><%= voice.mood_tags.first %></span>
                <% end %>
              </div>

              <div class="vbars" aria-hidden="true">
                <% 12.times do |j| %>
                  <i style="height:<%= [40, 70, 50, 90, 60, 80, 45, 75, 55, 85, 50, 65][j % 12] %>%"></i>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @voices.empty? %>
            <div style="grid-column:1/-1;padding:40px 0;text-align:center;color:var(--mute);">
              Nessuna voce disponibile al momento. Riprova tra poco.
            </div>
          <% end %>
        </div>

        <div class="callout" id="voicehint" style="margin-top:16px;">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
          Questa voce è disponibile solo con il piano Pro.
        </div>

        <div class="wzfoot between" style="margin-top:30px;">
          <%= link_to "Indietro", wizard_order_path(step: 3),
              class: "btn btn-secondary",
              data: { turbo_frame: "wizard" } %>
          <span class="mag">
            <%= f.submit "Continua", class: "btn btn-primary" %>
          </span>
        </div>

      <% end %>
    </div>

  </div>
<% end %>
