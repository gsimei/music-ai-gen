<% content_for :title, t_brand("wizard.title", default: "#{brand_name} · Crea il tuo jingle") %>
<% @step = 1 %>

<%= turbo_frame_tag "wizard", data: { turbo_action: "advance" } do %>
  <div class="wrap" style="padding-bottom:80px;">

    <div class="wzbar">
      <div class="lp">
        <%= render "shared/studio_logo" %>
      </div>
      <div class="meta">Passo 1 · 01 / 05</div>
    </div>

    <nav class="progress" aria-label="Progresso wizard">
      <% steps_meta = [
        { num: 1, short: "Info" },
        { num: 2, short: "Stile" },
        { num: 3, short: "Dettagli" },
        { num: 4, short: "Voce" },
        { num: 5, short: "Piano" }
      ] %>
      <% steps_meta.each do |s| %>
        <% state = s[:num] < @step ? "done" : s[:num] == @step ? "active" : "" %>
        <div class="pstep <%= state %>">
          <div class="bar"></div>
          <div class="meta">
            <span class="dot"></span>
            <span class="nm"><b>0<%= s[:num] %></b><%= s[:short] %></span>
          </div>
        </div>
      <% end %>
    </nav>

    <div class="wzhead reveal">
      <div class="eyebrow">Passo 1</div>
      <h2 class="display">Informazioni</h2>
      <p>Più ci racconti, più la musica sarà su misura.</p>
    </div>

    <% if @validator&.errors&.any? %>
      <div role="alert" class="callout show" style="margin-bottom:20px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
        <div>
          <% @validator.errors.each do |error| %>
            <div><%= error.full_message %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="wzbody">
      <%= form_with url: wizard_order_path(step: 1), method: :patch,
                    data: { turbo_frame: "wizard" } do |f| %>

        <div class="field reveal">
          <label for="wizard_about">
            Parlaci della tua attività
            <span aria-label="campo obbligatorio" style="color:var(--brass);">*</span>
          </label>
          <p style="font-size:11px;color:var(--mute);margin-bottom:7px;" id="about-hint">
            Nome, settore, valori, clienti tipici, tono di voce…
          </p>
          <%= f.text_area :about,
              name: "order_wizard[about]",
              id: "wizard_about",
              value: @wizard_session&.to_h&.dig(:about),
              required: true,
              rows: 4,
              "aria-describedby": "about-hint",
              "aria-invalid": @validator&.errors&.include?(:about) ? "true" : nil,
              class: "textarea",
              placeholder: "Es: Pasticceria artigianale a Milano, valori famigliari, clienti affezionati da 30 anni…" %>
        </div>

        <div class="field reveal">
          <label for="wizard_recipient">Nome dell'attività</label>
          <%= f.text_field :recipient,
              name: "order_wizard[recipient]",
              id: "wizard_recipient",
              value: @wizard_session&.to_h&.dig(:recipient),
              autocomplete: "off",
              class: "input",
              placeholder: "Pasticceria Marisa" %>
        </div>

        <div class="field reveal">
          <label for="wizard_occasion">Per cosa userai la musica?</label>
          <%= f.text_field :occasion,
              name: "order_wizard[occasion]",
              id: "wizard_occasion",
              value: @wizard_session&.to_h&.dig(:occasion),
              autocomplete: "off",
              class: "input",
              placeholder: "Reel Instagram, apertura nuovo punto vendita, spot radio…" %>
        </div>

        <div class="field reveal">
          <label for="wizard_visual_context">
            Descrivi il video o le immagini che accompagneranno la musica
          </label>
          <p style="font-size:11px;color:var(--mute);margin-bottom:7px;" id="visual-context-hint">
            Racconta cosa si vede: prodotti, location, persone, atmosfera, colori… Aiuta l'AI a sincronizzare testo e visivo.
          </p>
          <%= f.text_area :visual_context,
              name: "order_wizard[visual_context]",
              id: "wizard_visual_context",
              value: @wizard_session&.to_h&.dig(:visual_context),
              rows: 3,
              "aria-describedby": "visual-context-hint",
              class: "textarea",
              placeholder: "Es: video in slow motion della cucina, forno, mani che impastano, luce calda e atmosfera artigianale…" %>
        </div>

        <div class="wzfoot">
          <span class="mag">
            <%= f.submit "Continua", class: "btn btn-primary" %>
          </span>
        </div>

      <% end %>
    </div>

  </div>
<% end %>
