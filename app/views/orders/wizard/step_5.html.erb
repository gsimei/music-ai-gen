<% @step = 5 %>
<% brand_config = BRANDS_CONFIG[:b2b] %>
<% tiers = brand_config[:tiers] || {} %>
<% saved = @wizard_session&.to_h || {} %>
<% saved_tier = saved[:tier].to_s %>

<% chosen_voice = Voice.find_by(id: saved[:voice_id]) if saved[:voice_id].present? %>
<% voice_requires_pro = chosen_voice&.pro_only? %>

<%= turbo_frame_tag "wizard", data: { turbo_action: "advance" } do %>
  <div class="wrap" style="padding-bottom:80px;"
       data-controller="wizard-tier"
       data-wizard-tier-voice-requires-pro-value="<%= voice_requires_pro %>">

    <div class="wzbar">
      <div class="lp">
        <%= render "shared/studio_logo" %>
      </div>
      <div class="meta">Passo 5 · 05 / 05</div>
    </div>

    <nav class="progress" aria-label="Progresso wizard">
      <% steps_meta = [
        { num: 1, short: "Info" },
        { num: 2, short: "Stile" },
        { num: 3, short: "Dettagli" },
        { num: 4, short: "Voce" },
        { num: 5, short: "Piano" }
      ] %>
      <% steps_meta.each do |s| %>
        <% state = s[:num] < @step ? "done" : s[:num] == @step ? "active" : "" %>
        <div class="pstep <%= state %>">
          <div class="bar"></div>
          <div class="meta">
            <span class="dot"></span>
            <span class="nm"><b>0<%= s[:num] %></b><%= s[:short] %></span>
          </div>
        </div>
      <% end %>
    </nav>

    <div class="wzhead reveal">
      <div class="eyebrow">Passo 5</div>
      <h2 class="display">Revisione</h2>
      <p>Controlla le tue scelte e scegli il piano.</p>
    </div>

    <% if voice_requires_pro %>
      <div role="alert" aria-live="polite" class="callout show" style="margin-bottom:20px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
        La voce scelta è disponibile solo nel piano <strong>Pro</strong>. Il piano Standard è disabilitato.
      </div>
    <% end %>

    <% if @validator&.errors&.any? %>
      <div role="alert" class="callout show" style="margin-bottom:20px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--brass)" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v4M8 11h.01"/></svg>
        <div>Seleziona un piano per continuare.</div>
      </div>
    <% end %>

    <div class="wzbody" style="max-width:none;">
      <div class="card reveal" style="padding:20px 24px;margin-bottom:30px;">
        <div class="summary-tags">
          <% if saved[:recipient].present? %>
            <span class="tag"><b style="color:var(--ink)">Attività:</b> <%= saved[:recipient] %></span><span class="tag">·</span>
          <% end %>
          <% if saved[:music_style].present? %>
            <span class="tag"><b style="color:var(--ink)">Stile:</b> <%= saved[:music_style].capitalize %></span><span class="tag">·</span>
          <% end %>
          <% if chosen_voice %>
            <span class="tag"><b style="color:var(--ink)">Voce:</b> <%= chosen_voice.name %></span><span class="tag">·</span>
          <% end %>
          <% if saved[:language].present? %>
            <span class="tag"><b style="color:var(--ink)">Lingua:</b> <%= saved[:language].upcase %></span>
          <% end %>
        </div>
      </div>

      <%= form_with url: wizard_order_path(step: 5), method: :patch,
                    data: { turbo_frame: "wizard", "wizard-tier-target": "form" },
                    id: "tier-form" do |f| %>
        <%= f.hidden_field :_present, name: "order_wizard[_present]", value: "1" %>

        <div class="tiers reveal"
             role="radiogroup"
             aria-label="Seleziona un piano">
          <% tiers.each_with_index do |(tier_key, tier_data), i| %>
            <%
              tier_name = tier_key.to_s
              is_pro = tier_name == "pro"
              is_standard = !is_pro
              is_selected = saved_tier == tier_name || (voice_requires_pro && is_pro && saved_tier.blank?)
              is_disabled = voice_requires_pro && is_standard
              price_fmt = "€#{(tier_data[:price_cents].to_f / 100).to_i}"
            %>
            <% if is_pro %>
              <div class="card-ink tier tier-ink selectable <%= is_selected ? 'sel' : '' %>"
                   data-wizard-tier-target="card"
                   data-tier="<%= tier_name %>"
                   data-action="click->wizard-tier#selectTier">
                <span class="striptop badge badge-brass">— Top —</span>
                <div class="top">
                  <div class="plan"><%= tier_name.capitalize %></div>
                  <div class="price"><em><%= price_fmt %></em><small style="color:rgba(245,241,231,.55);"> / una tantum</small></div>
                </div>
                <ul>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:max_duration_seconds] %> secondi · stems separati</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:lyrics_regen_limit] %> rigenerazioni del testo</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:music_regen_limit] %> rigenerazioni della musica</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> Voci premium del catalogo</li>
                </ul>
                <input type="radio"
                       name="order_wizard[tier]"
                       value="<%= tier_name %>"
                       <%= "checked" if is_selected %>
                       class="sr-only"
                       aria-label="Piano <%= tier_name.capitalize %> <%= price_fmt %>"
                       data-wizard-tier-target="radio"
                       data-tier="<%= tier_name %>"
                       data-action="change->wizard-tier#selectTier">
              </div>
            <% else %>
              <div class="card tier selectable <%= is_selected ? 'sel' : '' %> <%= is_disabled ? 'disabled' : '' %>"
                   style="<%= 'opacity:.5;pointer-events:none;' if is_disabled %>"
                   data-wizard-tier-target="card"
                   data-tier="<%= tier_name %>"
                   data-action="click->wizard-tier#selectTier">
                <div class="top">
                  <div class="plan"><%= tier_name.capitalize %></div>
                  <div class="price"><%= price_fmt %><small> / una tantum</small></div>
                </div>
                <ul>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:max_duration_seconds] %> secondi di musica</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:lyrics_regen_limit] %> rigenerazioni del testo</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> <%= tier_data[:music_regen_limit] %> rigenerazione della musica</li>
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg> Licenza commerciale · 24h</li>
                </ul>
                <input type="radio"
                       name="order_wizard[tier]"
                       value="<%= tier_name %>"
                       <%= "checked" if is_selected %>
                       <%= "disabled" if is_disabled %>
                       class="sr-only"
                       aria-label="Piano <%= tier_name.capitalize %> <%= price_fmt %><%= is_disabled ? ' — non disponibile con la voce scelta' : '' %>"
                       data-wizard-tier-target="radio"
                       data-tier="<%= tier_name %>"
                       data-action="change->wizard-tier#selectTier">
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="wzfoot between" style="align-items:center;margin-top:30px;">
          <%= link_to "Indietro", wizard_order_path(step: 4),
              class: "btn btn-secondary",
              data: { turbo_frame: "wizard" } %>
          <div style="text-align:right;">
            <span class="mag">
              <button type="submit"
                      form="tier-form"
                      id="finalize-cta"
                      <%= "disabled" unless saved_tier.present? || voice_requires_pro %>
                      class="btn btn-primary"
                      data-wizard-tier-target="submitBtn"
                      aria-label="Finalizza e vai al pagamento">
                Finalizza e paga
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4L8 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </button>
            </span>
            <div style="font-size:10px;letter-spacing:.04em;color:var(--mute);margin-top:8px;">Checkout sicuro con Stripe</div>
          </div>
        </div>

      <% end %>
    </div>

  </div>
<% end %>
