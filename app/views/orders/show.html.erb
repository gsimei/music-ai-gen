<% content_for :title, @order.reference %>

<div class="wrap" style="padding-top:40px;padding-bottom:80px;">

  <div class="orderhead reveal">
    <div>
      <div class="ref"><%= @order.reference %></div>
      <div class="biz"><%= @order.briefing&.recipient.presence || @order.briefing&.about.to_s.truncate(40) %></div>
      <% if @order.briefing %>
        <div class="summary-tags">
          <% if @order.briefing.music_style.present? %>
            <span class="pill" style="cursor:default"><%= @order.briefing.music_style.capitalize %></span>
          <% end %>
          <% if @order.briefing.language.present? %>
            <span class="pill" style="cursor:default"><%= @order.briefing.language.upcase %></span>
          <% end %>
          <% if @order.briefing.mood.present? %>
            <span class="pill" style="cursor:default"><%= @order.briefing.mood.capitalize %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <span class="badge <%=
      case @order.status
      when 'paid', 'lyrics_drafting'          then 'badge-amber'
      when 'lyrics_ready', 'lyrics_approved'  then 'badge-brass'
      when 'music_generating'                 then 'badge-amber'
      when 'preview_ready', 'approved'        then 'badge-brass'
      when 'music_failed', 'lyrics_failed',
           'lyrics_generation_failed'         then 'badge-amber'
      else                                         'badge-amber'
      end
    %>" style="padding:7px 14px;font-size:10px;">
      <% if @order.lyrics_drafting? || @order.music_generating? || @order.lyrics_approved? %>
        ●
      <% end %>
      <%=
        case @order.status
        when 'paid', 'lyrics_drafting'              then 'Testo in lavorazione'
        when 'lyrics_ready', 'lyrics_approved'      then 'Testo pronto'
        when 'music_generating'                     then 'Musica in lavorazione'
        when 'preview_ready'                        then 'Anteprima pronta'
        when 'approved'                             then 'Jingle approvato'
        when 'pending'                              then 'In attesa di pagamento'
        else @order.status.humanize
        end
      %>
    </span>
  </div>

  <% if notice.present? %>
    <div role="alert" aria-live="polite" class="callout show" style="margin:16px 0;">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div role="alert" aria-live="assertive" class="callout show" style="margin:16px 0;">
      <%= alert %>
    </div>
  <% end %>

  <%= turbo_stream_from "order_#{@order.id}_lyrics" %>
  <%= turbo_stream_from "order_#{@order.id}_music" %>

  <% if @order.soundtrack_order? %>
    <%= render "orders/soundtrack_section", order: @order, soundtrack_input: @soundtrack_input %>
  <% else %>
    <%= render "orders/lyrics_section", order: @order, draft: @draft %>
    <%= render "orders/music_section", order: @order, assets: @assets %>
  <% end %>

</div>
