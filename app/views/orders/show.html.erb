<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-2xl mx-auto">

    <%# Flash messages %>
    <% if notice %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm"><%= alert %></div>
    <% end %>

    <%# Header %>
    <div class="mb-8 text-center">
      <p class="text-sm text-gray-500 mb-1"><%= @order.reference %></p>
      <h1 class="text-2xl font-bold text-gray-900">Riepilogo ordine</h1>
    </div>

    <%# Order card %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">

      <%# Status badge %>
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm font-medium text-gray-600">Stato</span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold
          <%= @order.pending? ? 'bg-yellow-100 text-yellow-800' :
              @order.paid? ? 'bg-blue-100 text-blue-800' :
              @order.lyrics_ready? ? 'bg-purple-100 text-purple-800' :
              @order.delivered? ? 'bg-green-100 text-green-800' :
              'bg-gray-100 text-gray-700' %>">
          <%= @order.status.humanize %>
        </span>
      </div>

      <%# Briefing details %>
      <% if @order.briefing %>
        <% b = @order.briefing %>
        <div class="px-6 py-5 space-y-4">
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Descrição</p>
            <p class="text-gray-800 text-sm leading-relaxed"><%= b.about %></p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Estilo</p>
              <p class="text-gray-800 text-sm"><%= b.music_style %></p>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Idioma</p>
              <p class="text-gray-800 text-sm"><%= b.language.upcase %></p>
            </div>
            <% if b.recipient.present? %>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Destinatário</p>
                <p class="text-gray-800 text-sm"><%= b.recipient %></p>
              </div>
            <% end %>
            <% if b.mood.present? %>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Tom</p>
                <p class="text-gray-800 text-sm"><%= b.mood %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Price / tier %>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-700">Plano <span class="capitalize"><%= @order.tier %></span></p>
          <p class="text-xs text-gray-400">
            <%= @order.lyrics_regen_limit %> reescrita<%= @order.lyrics_regen_limit == 1 ? '' : 's' %> de letra
            · <%= @order.music_regen_limit %> variante<%= @order.music_regen_limit == 1 ? '' : 's' %> de música
          </p>
        </div>
        <p class="text-2xl font-bold text-gray-900">€<%= sprintf("%.2f", @order.price_cents / 100.0) %></p>
      </div>
    </div>

    <%# CTA based on status %>
    <div class="space-y-3">
      <% if @order.pending? %>
        <%= button_to checkout_order_path(@order),
              method: :post,
              form: { data: { turbo: false } },
              class: "w-full py-4 px-6 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-center transition-colors" do %>
          Pagar e gerar música →
        <% end %>
        <p class="text-xs text-center text-gray-400">Pagamento seguro via Stripe</p>

      <% elsif @order.lyrics_ready? %>
        <%= link_to "Ver e aprovar letra →", order_lyrics_path(@order),
              class: "block w-full py-4 px-6 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-xl text-center transition-colors" %>

      <% elsif @order.lyrics_drafting? %>
        <div class="w-full py-4 px-6 bg-gray-100 text-gray-500 font-semibold rounded-xl text-center">
          <span class="animate-pulse">Gerando letra...</span>
        </div>

      <% elsif @order.delivered? %>
        <div class="w-full py-4 px-6 bg-green-100 text-green-800 font-semibold rounded-xl text-center">
          ✓ Entregue
        </div>

      <% else %>
        <div class="w-full py-4 px-6 bg-gray-100 text-gray-500 font-semibold rounded-xl text-center">
          <%= @order.status.humanize %>
        </div>
      <% end %>
    </div>

  </div>
</div>
