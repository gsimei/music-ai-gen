<%# locals: (current_step:) %>
<%
  steps = [
    { num: 1, label: "Informazioni" },
    { num: 2, label: "Stile" },
    { num: 3, label: "Dettagli" },
    { num: 4, label: "Voce" },
    { num: 5, label: "Revisione" }
  ]
%>

<nav aria-label="Progresso wizard" class="px-4 pt-4 pb-3 sm:px-6">
  <%# Step dots bar %>
  <div class="flex items-center gap-0 mb-3" role="list">
    <% steps.each_with_index do |step, i| %>
      <%
        done    = step[:num] < current_step
        active  = step[:num] == current_step
        future  = step[:num] > current_step
        segment_color = done || active ? "bg-cant-brass" : "bg-cant-line"
      %>

      <li role="listitem" class="flex items-center flex-1 last:flex-none">
        <%# Dot %>
        <div
          class="relative flex-none w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-colors duration-200
                 <%= if done
                       'bg-cant-brass text-cant-ink'
                     elsif active
                       'bg-cant-ink text-cant-paper ring-2 ring-offset-1 ring-cant-ink'
                     else
                       'bg-cant-line text-cant-mute'
                     end %>"
          <% if active %>
            aria-current="step"
            aria-label="Passo <%= step[:num] %>: <%= step[:label] %> — corrente"
          <% elsif done %>
            aria-label="Passo <%= step[:num] %>: <%= step[:label] %> — completato"
          <% else %>
            aria-label="Passo <%= step[:num] %>: <%= step[:label] %> — in attesa"
          <% end %>
        >
          <% if done %>
            <%# Checkmark SVG %>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          <% else %>
            <span aria-hidden="true"><%= step[:num] %></span>
          <% end %>
        </div>

        <%# Connector segment (not after last) %>
        <% unless step[:num] == 5 %>
          <div class="flex-1 h-0.5 mx-1 <%= segment_color %> transition-colors duration-300" aria-hidden="true"></div>
        <% end %>
      </li>
    <% end %>
  </div>

  <%# Step labels (visible on sm+) %>
  <div class="hidden sm:flex justify-between" aria-hidden="true">
    <% steps.each do |step| %>
      <%
        done   = step[:num] < current_step
        active = step[:num] == current_step
        label_class = if active
          'text-cant-ink font-semibold'
        elsif done
          'text-cant-brass'
        else
          'text-cant-mute'
        end
      %>
      <span class="text-[10px] tracking-wide uppercase <%= label_class %>"><%= step[:label] %></span>
    <% end %>
  </div>
</nav>
