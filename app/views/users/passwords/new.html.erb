<% content_for :title, "#{brand_name} · Recuperar senha" %>
<%= render layout: "users/shared/studio_auth" do %>
  <p class="studio-kicker">RECUPERE SEU ACESSO</p>
  <h1>Recuperar acesso</h1>
  <p class="studio-form-intro">Informe seu e-mail para receber as instruções e criar uma nova senha.</p>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :post } do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <div class="studio-field"><%= f.label :email, "Email" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %></div>
    <%= f.submit "Enviar instruções", class: "studio-button studio-button-green studio-submit" %>
  <% end %>
  <p class="studio-form-switch"><%= link_to "Voltar para entrar", new_user_session_path %></p>
<% end %>
