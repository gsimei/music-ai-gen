<% content_for :title, "#{brand_name} · Nova senha" %>
<%= render layout: "users/shared/studio_auth" do %>
  <p class="studio-kicker">SUA CONTA</p>
  <h1>Criar nova senha</h1>
  <p class="studio-form-intro">Escolha uma nova senha para sua conta.</p>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :put } do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="studio-field"><%= f.label :password, "Nova senha" %><div class="jp-password" data-controller="password-visibility"><%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, minlength: @minimum_password_length %><button type="button" data-action="password-visibility#toggle" aria-pressed="false" aria-label="Mostrar senha">Mostrar</button></div></div>
    <div class="studio-field"><%= f.label :password_confirmation, "Confirme a senha" %><div class="jp-password" data-controller="password-visibility"><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %><button type="button" data-action="password-visibility#toggle" aria-pressed="false" aria-label="Mostrar senha">Mostrar</button></div></div>
    <%= f.submit "Salvar senha", class: "studio-button studio-button-green studio-submit" %>
  <% end %>
  <p class="studio-form-switch"><%= link_to "Voltar para entrar", new_user_session_path %></p>
<% end %>
