<% content_for :title, "#{brand_name} · Criar conta" %>
<%= render layout: "users/shared/studio_auth" do %>
  <p class="studio-kicker">SUA PRIMEIRA CAMPANHA COMEÇA AQUI</p>
  <h1>Criar sua conta</h1>
  <% if campaign_draft_resume_path %>
    <p class="studio-form-intro" data-guest-campaign-notice>Sua campanha está guardada neste navegador. Crie sua conta para continuar para o pagamento, com os dados e fotos que você já escolheu.</p>
  <% else %>
    <p class="studio-form-intro">Crie sua conta para salvar e acompanhar a campanha.</p>
  <% end %>
  <%= render "users/shared/error_messages", resource: resource %>
  <%= form_for resource, as: resource_name, url: registration_path(resource_name) do |f| %>
    <div class="studio-field"><%= f.label :email, "Email" %><%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "voce@seunegocio.com.br", required: true %></div>
    <div class="studio-field">
      <%= f.label :password, "Senha" %>
      <div class="jp-password" data-controller="password-visibility"><%= f.password_field :password, autocomplete: "new-password", required: true, minlength: @minimum_password_length, aria: { describedby: "password-hint" } %><button type="button" data-action="password-visibility#toggle" aria-pressed="false" aria-label="Mostrar senha">Mostrar</button></div>
      <p id="password-hint" class="studio-field-hint">Pelo menos <%= @minimum_password_length %> caracteres</p>
    </div>
    <div class="studio-field"><%= f.label :password_confirmation, "Confirme a senha" %><div class="jp-password" data-controller="password-visibility"><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %><button type="button" data-action="password-visibility#toggle" aria-pressed="false" aria-label="Mostrar senha">Mostrar</button></div></div>
    <%= f.button class: "studio-button studio-button-green studio-submit" do %>Criar conta <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg><% end %>
    <p class="studio-form-switch">Já tem uma conta? <%= link_to "Entrar", new_user_session_path %></p>
  <% end %>
<% end %>
