<% content_for :title, "Recuperar seu acesso · JinglePro" %>
<%= render layout: "users/shared/studio_auth" do %>
  <h1>Recuperar seu acesso</h1><p class="studio-form-intro">Enviaremos instruções para desbloquear sua conta.</p>
  <%= form_for resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post } do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <div class="studio-field"><%= f.label :email, "E-mail" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %></div>
    <%= f.submit "Enviar instruções", class: "studio-button studio-button-green studio-submit" %>
  <% end %>
  <p class="studio-form-switch"><%= link_to "Voltar para entrar", new_user_session_path %></p>
<% end %>
