<% content_for :title, "#{brand_name} · Entrar" %>
<%= render layout: "users/shared/studio_auth" do %>
  <h1>Entrar na sua conta</h1>
  <p class="studio-form-intro">Acompanhe suas campanhas e baixe os vídeos.</p>
  <%= render "users/shared/error_messages", resource: resource %>
  <%= form_for resource, as: resource_name, url: session_path(resource_name) do |f| %>
    <div class="studio-field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "voce@seunegocio.com.br", required: true %>
    </div>
    <div class="studio-field">
      <div class="studio-label-row"><%= f.label :password, "Senha" %><%= link_to "Esqueceu a senha?", new_user_password_path %></div>
      <div class="jp-password" data-controller="password-visibility"><%= f.password_field :password, autocomplete: "current-password", required: true %><button type="button" data-action="password-visibility#toggle" aria-pressed="false" aria-label="Mostrar senha">Mostrar</button></div>
    </div>
    <%= f.button class: "studio-button studio-button-green studio-submit" do %>Entrar na minha conta <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg><% end %>
    <p class="studio-form-switch">Ainda não tem uma conta? <%= link_to "Criar conta", new_user_registration_path %></p>
  <% end %>
<% end %>
