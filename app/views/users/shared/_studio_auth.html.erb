<% content_for :body_class, "studio-page" %>
<div class="studio-home studio-app studio-auth">
  <aside class="studio-auth-brand">
    <%= render "shared/studio_logo" %>
    <div class="studio-auth-pitch">
      <h2>Sua promoção, em <em>música</em> e vídeo.</h2>
      <ul class="jp-checks"><li>Você aprova a letra antes da música</li><li>Duas versões de música por rodada</li><li>Vídeo vertical pronto para postar</li></ul>
      <figure class="jp-auth-photo"><img src="/demos/photos/pizzaria-forno-da-vila.png" alt="Pizzas de uma campanha de exemplo"><figcaption>Terça da pizza,<br><strong>R$ 79,90.</strong></figcaption></figure>
    </div>
    <p class="studio-auth-caption">Uma boa oferta merece ser ouvida.</p>
  </aside>
  <main class="studio-auth-main">
    <%= link_to(campaign_draft_resume_path ? "Voltar à minha campanha" : "Voltar ao início", campaign_draft_resume_path || root_path, class: "studio-auth-back") %>
    <div class="studio-auth-form"><%= render "shared/studio_flash" %><%= yield %></div>
    <p class="studio-auth-foot">Feito para o comércio de verdade.</p>
  </main>
</div>
