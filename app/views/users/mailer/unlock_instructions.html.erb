<% product_name = BRANDS_CONFIG.fetch(:b2b).fetch(:display_name) %>
<% content_for :preheader, "Desbloqueie sua conta para voltar às suas campanhas." %>
<% url = unlock_url(@resource, unlock_token: @token) %>
<h1 style="margin:0 0 24px;font-size:30px;line-height:36px;color:#173e32;">Recupere seu acesso.</h1>
<p style="margin:0 0 16px;font-size:16px;line-height:26px;">Olá!</p>
<p style="margin:0 0 24px;font-size:16px;line-height:26px;">O acesso à sua conta na <%= product_name %> foi bloqueado temporariamente após várias tentativas de entrada sem sucesso. Use o botão abaixo para desbloquear.</p>
<p style="margin:0 0 24px;"><%= link_to "Desbloquear minha conta", url, style: "display:inline-block;padding:16px 28px;border-radius:100px;background-color:#173e32;color:#fffef9;font-size:16px;font-weight:bold;text-decoration:none;" %></p>
<p style="margin:0 0 16px;font-size:14px;line-height:23px;color:#4c6155;">O botão não abriu? Copie e cole este endereço no navegador:</p>
<p style="margin:0;font-size:12px;line-height:20px;word-break:break-all;"><%= link_to url, url, style: "color:#24593e;word-break:break-all;" %></p>
