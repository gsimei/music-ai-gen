<% product_name = BRANDS_CONFIG.fetch(:b2b).fetch(:display_name) %>
<% content_for :preheader, "Sua senha foi alterada. Confira este aviso sobre sua conta." %>
<h1 style="margin:0 0 24px;font-size:30px;line-height:36px;color:#173e32;">Sua senha foi alterada.</h1>
<p style="margin:0 0 16px;font-size:16px;line-height:26px;">Olá!</p>
<p style="margin:0 0 24px;font-size:16px;line-height:26px;">A senha da sua conta na <strong><%= product_name %></strong> foi alterada com sucesso.</p>
<p style="margin:0;font-size:14px;line-height:23px;color:#4c6155;">Se você não fez essa alteração, <%= link_to "crie uma nova senha para recuperar seu acesso", new_password_url(@resource), style: "color:#24593e;" %>.</p>
