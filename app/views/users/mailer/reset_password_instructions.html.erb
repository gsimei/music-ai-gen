<% product_name = BRANDS_CONFIG.fetch(:b2b).fetch(:display_name) %>
<% content_for :preheader, "Crie uma nova senha para voltar às suas campanhas." %>
<% reset_url = edit_password_url(@resource, reset_password_token: @token) %>
<% validity_hours = @resource.class.reset_password_within.to_i / 1.hour.to_i %>
<p style="margin:0 0 16px;font-size:12px;font-weight:bold;letter-spacing:1.5px;color:#4c6155;">ACESSO À SUA CONTA</p>
<h1 style="margin:0 0 24px;font-size:30px;line-height:36px;letter-spacing:-0.7px;color:#173e32;">Vamos recuperar<br>seu acesso.</h1>
<p style="margin:0 0 16px;font-size:16px;line-height:26px;">Olá!</p>
<p style="margin:0 0 24px;font-size:16px;line-height:26px;">Recebemos um pedido para redefinir a senha da sua conta na <strong><%= product_name %></strong>. Use o botão abaixo para criar uma nova senha e voltar às suas campanhas.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td bgcolor="#173e32" style="border-radius:100px;"><%= link_to "Criar nova senha", reset_url, style: "display:inline-block;padding:16px 28px;border:1px solid #173e32;border-radius:100px;background-color:#173e32;color:#fffef9;font-size:16px;font-weight:bold;line-height:22px;text-align:center;text-decoration:none;" %></td></tr>
</table>
<p style="margin:0 0 24px;padding:14px 16px;background-color:#e5eadc;border-radius:12px;font-size:14px;line-height:22px;color:#173e32;">Este link é válido por <strong><%= pluralize(validity_hours, "hora", "horas") %></strong> e só pode ser usado uma vez.</p>
<p style="margin:0 0 24px;font-size:14px;line-height:23px;color:#4c6155;">Se você não fez esse pedido, ignore esta mensagem. Sua senha só será alterada quando você criar uma nova pelo link.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="padding-top:24px;border-top:1px solid #cfd8c9;">
    <p style="margin:0 0 8px;font-size:12px;line-height:20px;color:#4c6155;">O botão não abriu? Copie e cole este endereço no seu navegador:</p>
    <p style="margin:0;font-size:12px;line-height:20px;word-break:break-all;overflow-wrap:anywhere;"><%= link_to reset_url, reset_url, style: "color:#24593e;text-decoration:underline;word-break:break-all;overflow-wrap:anywhere;" %></p>
  </td></tr>
</table>
